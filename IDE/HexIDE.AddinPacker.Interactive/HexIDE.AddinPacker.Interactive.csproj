<Project Sdk="Microsoft.NET.Sdk">

  <!--
    hexide-pack (#5555): the add-in packer for people. Given a command, it prompts for whatever wasn't supplied,
    then hands the finished command line to HexIDE.AddinPacker's own dispatch (PackerCli.Run), so there is one
    signing path. Spectre.Console lives here and only here. HexIDE.AddinPacker, which the Desktop build packs
    with and the release's signing job runs next to the first-party key, keeps no packages
    (PackerFrontEndBoundaryTests).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <AssemblyName>hexide-pack</AssemblyName>
    <RootNamespace>HexIDE.AddinPacker.Interactive</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HexIDE.AddinPacker\HexIDE.AddinPacker.csproj" />
  </ItemGroup>

</Project>
