<SyntaxDefinition name="VB6" extensions=".vb6;.bas;.frm;.cls" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Comment" foreground="#008000" />
  <Color name="String" foreground="#A31515" />
  <Color name="Number" foreground="#A31515" />
  <Color name="Constant" foreground="#A31515" />
  <Color name="Keyword" foreground="#0000B0" />
  <Color name="IOKeyword" foreground="#0000B0" />
  <Color name="StorageModifier" foreground="#0000B0" />
  <Color name="Type" foreground="#0000B1" />
  <Color name="Function" foreground="#74531F" />
  <Color name="MetadataKeyword" foreground="#A000A0" />
  <RuleSet ignoreCase="true">
    <Rule color="Comment">(?:'|\bRem\b).*$</Rule>
    <Rule color="String">"(?:[^"\r\n]|"")*"</Rule>
    <Rule color="Constant">\#[ \t]*(?:(?:[0-9]+|(?:Jan(?:u(?:a(?:r(?:y)?)?)?)?|Feb(?:r(?:u(?:a(?:r(?:y)?)?)?)?)?|Mar(?:c(?:h)?)?|Apr(?:i(?:l)?)?|May|Jun(?:e)?|Jul(?:y)?|Aug(?:u(?:s(?:t)?)?)?|Sep(?:t(?:e(?:m(?:b(?:e(?:r)?)?)?)?)?)?|Oct(?:o(?:b(?:e(?:r)?)?)?)?|Nov(?:e(?:m(?:b(?:e(?:r)?)?)?)?)?|Dec(?:e(?:m(?:b(?:e(?:r)?)?)?)?)?|Sun(?:d(?:a(?:y)?)?)?|Mon(?:d(?:a(?:y)?)?)?|Tue(?:s(?:d(?:a(?:y)?)?)?)?|Wed(?:s|n(?:e(?:s(?:d(?:a(?:y)?)?)?)?)?)?|Thu(?:r(?:s(?:d(?:a(?:y)?)?)?)?)?|Fri(?:d(?:a(?:y)?)?)?|Sat(?:u(?:r(?:d(?:a(?:y)?)?)?)?)?)\.?)(?:[ \t/.,:\-]+(?:[0-9]+|(?:Jan(?:u(?:a(?:r(?:y)?)?)?)?|Feb(?:r(?:u(?:a(?:r(?:y)?)?)?)?)?|Mar(?:c(?:h)?)?|Apr(?:i(?:l)?)?|May|Jun(?:e)?|Jul(?:y)?|Aug(?:u(?:s(?:t)?)?)?|Sep(?:t(?:e(?:m(?:b(?:e(?:r)?)?)?)?)?)?|Oct(?:o(?:b(?:e(?:r)?)?)?)?|Nov(?:e(?:m(?:b(?:e(?:r)?)?)?)?)?|Dec(?:e(?:m(?:b(?:e(?:r)?)?)?)?)?|Sun(?:d(?:a(?:y)?)?)?|Mon(?:d(?:a(?:y)?)?)?|Tue(?:s(?:d(?:a(?:y)?)?)?)?|Wed(?:s|n(?:e(?:s(?:d(?:a(?:y)?)?)?)?)?)?|Thu(?:r(?:s(?:d(?:a(?:y)?)?)?)?)?|Fri(?:d(?:a(?:y)?)?)?|Sat(?:u(?:r(?:d(?:a(?:y)?)?)?)?)?)\.?))+(?:[ \t]*[AP]M?)?|[0-9]+[ \t]*[AP]M?)[ \t]*\#</Rule>
    <Rule color="Number">(?&lt;![\p{L}\p{N}_])(?:(?:&amp;H[0-9A-F]+|&amp;O[0-7]+)[&amp;%]?|(?:[0-9]+(?:\.[0-9]*)?|\.[0-9]+)(?:[ED][+\-]?[0-9]+)*[\#&amp;!@%]?)</Rule>
    <Rule color="Type">(?&lt;=[\p{L}\p{N}_])[%&amp;!\#@$]</Rule>
    <Rule color="Keyword">(?&lt;=[ \t])_[ \t]*$</Rule>
