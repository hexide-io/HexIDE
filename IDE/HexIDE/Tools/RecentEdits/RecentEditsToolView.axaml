<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tools="clr-namespace:HexIDE.Tools"
             x:Class="HexIDE.Tools.RecentEditsToolView"
             x:DataType="tools:RecentEditsToolViewModel">
    <ListBox ItemsSource="{CompiledBinding Entries}" SelectedItem="{CompiledBinding SelectedEntry, Mode=TwoWay}"
             AutomationProperties.AutomationId="RecentEdits.Locations">
        <ListBox.ItemTemplate>
            <DataTemplate x:DataType="tools:RecentEditLocation">
                <StackPanel Margin="4,2">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{CompiledBinding Module}" />
                        <TextBlock Text="{CompiledBinding Line}" />
                    </StackPanel>
                    <TextBlock Text="{CompiledBinding Preview}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DataTemplate>
        </ListBox.ItemTemplate>
    </ListBox>
</UserControl>
