<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:HexIDE.Tools.Diagnostics"
             x:Class="HexIDE.Tools.Diagnostics.DiagnosticsToolView"
             x:DataType="vm:DiagnosticsToolViewModel">
    <Grid RowDefinitions="Auto,*">
        <StackPanel Orientation="Horizontal" Spacing="12" Margin="8">
            <CheckBox IsChecked="{CompiledBinding Errors}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{DynamicResource Str.Tool.Diagnostics.Errors}" />
                    <TextBlock Text="{CompiledBinding ErrorCount}" />
                </StackPanel>
            </CheckBox>
            <CheckBox IsChecked="{CompiledBinding Warnings}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{DynamicResource Str.Tool.Diagnostics.Warnings}" />
                    <TextBlock Text="{CompiledBinding WarningCount}" />
                </StackPanel>
            </CheckBox>
            <CheckBox IsChecked="{CompiledBinding Information}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{DynamicResource Str.Tool.Diagnostics.Information}" />
                    <TextBlock Text="{CompiledBinding InformationCount}" />
                </StackPanel>
            </CheckBox>
            <CheckBox IsChecked="{CompiledBinding Hints}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{DynamicResource Str.Tool.Diagnostics.Hints}" />
                    <TextBlock Text="{CompiledBinding HintCount}" />
                </StackPanel>
            </CheckBox>
            <CheckBox Content="{DynamicResource Str.Tool.Diagnostics.CurrentDocument}" IsChecked="{CompiledBinding CurrentDocumentOnly}" />
        </StackPanel>
        <DataGrid Grid.Row="1" ItemsSource="{CompiledBinding Rows}" SelectedItem="{CompiledBinding SelectedRow, Mode=TwoWay}"
                  IsReadOnly="True" AutoGenerateColumns="False" DoubleTapped="OnDoubleTapped" KeyDown="OnKeyDown">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{DynamicResource Str.Tool.Diagnostics.Severity}" Binding="{CompiledBinding SeverityText, x:DataType=vm:DiagnosticRow}" Width="Auto" />
                <DataGridTextColumn Header="{DynamicResource Str.Tool.Diagnostics.Server}" Binding="{CompiledBinding Server, x:DataType=vm:DiagnosticRow}" Width="Auto" />
                <DataGridTemplateColumn Header="{DynamicResource Str.Tool.Diagnostics.Document}" SortMemberPath="Document" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:DiagnosticRow">
                            <TextBlock Text="{CompiledBinding Document}" ToolTip.Tip="{CompiledBinding FullPath}" Margin="4,0" VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{DynamicResource Str.Tool.Diagnostics.Line}" Binding="{CompiledBinding Line, x:DataType=vm:DiagnosticRow}" Width="Auto" />
                <DataGridTemplateColumn Header="{DynamicResource Str.Tool.Diagnostics.Message}" SortMemberPath="Message" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:DiagnosticRow">
                            <TextBlock Text="{CompiledBinding Message}" Opacity="{CompiledBinding MessageOpacity}"
                                       TextDecorations="{CompiledBinding MessageDecorations}" Margin="4,0" VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{DynamicResource Str.Tool.Diagnostics.Source}" Binding="{CompiledBinding Source, x:DataType=vm:DiagnosticRow}" Width="Auto" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
