<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ls="clr-namespace:HexIDE.Tools.LanguageServers"
             mc:Ignorable="d" d:DesignWidth="720" d:DesignHeight="520"
             x:DataType="ls:LanguageServersToolViewModel"
             x:Class="HexIDE.Tools.LanguageServers.LanguageServersToolView">

    <UserControl.Styles>
        <!-- Machine text: ids, commands, pipe names, raw JSON. Monospace because the reason it is here is
             to be compared, character for character, against what the user wrote in their own file. -->
        <Style Selector="TextBlock.machine">
            <Setter Property="FontFamily" Value="Courier New" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="Width" Value="96" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="10">
        <StackPanel Spacing="14">

            <!-- Nothing attached at all. Its own message, because "no servers" and "servers, none working"
                 are different situations and an empty list says neither. -->
            <TextBlock IsVisible="{CompiledBinding HasNoServers}"
                       TextWrapping="Wrap"
                       Text="{DynamicResource Str.Tool.LanguageServers.None}" />

            <!-- What arming means, said once for the whole window rather than beside every checkbox.
                 Three things about it are surprising and all three are load-bearing: envelopes are recorded
                 unconditionally, the opening handshake is kept whatever the toggle says, and none of it
                 outlives the session. -->
            <Border BorderBrush="{DynamicResource DockTitleBarBrush}" BorderThickness="1" Padding="8">
                <StackPanel Spacing="4">
                    <TextBlock FontWeight="Bold"
                               Text="{DynamicResource Str.Tool.LanguageServers.Capture}" />

                    <TextBlock TextWrapping="Wrap" Opacity="0.75"
                               Text="{DynamicResource Str.Tool.LanguageServers.CaptureExplained}" />

                    <!-- The one arming question a per-row toggle cannot answer. A server starts on the
                         first document of a language it claims, so the connection somebody most wants to
                         arm is the one with no row to tick. -->
                    <CheckBox Margin="0,4,0,0"
                              IsChecked="{CompiledBinding ArmsFutureServers}"
                              Content="{DynamicResource Str.Tool.LanguageServers.ArmFuture}" />

                    <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="24,0,0,0"
                               Text="{DynamicResource Str.Tool.LanguageServers.ArmFutureExplained}" />

                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                        <!-- ALWAYS PRESENT. The inspector never opens itself — a window that appears
                             uninvited is one people learn to close reflexively — so it has to be one action
                             from where trouble is reported, and this is where trouble is reported. -->
                        <Button Command="{CompiledBinding ShowAllMessagesCommand}"
                                Content="{DynamicResource Str.Tool.LanguageServers.ShowAllMessages}" />

                        <!-- THE DELIVERABLE for the case this window exists to serve: telling whoever wrote
                             a server what HexIDE observed, without them having to install HexIDE. -->
                        <Button Click="CopyReport_OnClick"
                                Content="{DynamicResource Str.Tool.LanguageServers.CopyReport}" />

                        <TextBlock VerticalAlignment="Center" Opacity="0.75" TextWrapping="Wrap"
                                   Text="{DynamicResource Str.Tool.LanguageServers.ReportRedacted}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{CompiledBinding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="ls:LanguageServerGroupViewModel">
                        <StackPanel Margin="0,0,0,10">
                            <!-- The language is the group, so what a user has FOR a language reads together. -->
                            <TextBlock Text="{CompiledBinding Language}"
                                       FontWeight="Bold" FontSize="14" Margin="0,0,0,4" />

                            <ItemsControl ItemsSource="{CompiledBinding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="ls:LanguageServerRowViewModel">
                                        <Border BorderBrush="{DynamicResource DockTitleBarBrush}"
                                                BorderThickness="1" Padding="8" Margin="0,0,0,6">
                                            <StackPanel Spacing="3">

                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Classes="machine"
                                                               Margin="8,0,0,0" Opacity="0.7"
                                                               Text="{CompiledBinding Kind}" />
                                                    <TextBlock Text="{CompiledBinding DisplayName}"
                                                               FontWeight="Bold" />
                                                </DockPanel>

                                                <Grid ColumnDefinitions="96,*">
                                                    <TextBlock Classes="label" Grid.Column="0"
                                                               Text="{DynamicResource Str.Tool.LanguageServers.Id}" />
                                                    <TextBlock Grid.Column="1" Classes="machine" Text="{CompiledBinding Id}" />
                                                </Grid>

                                                <Grid ColumnDefinitions="96,*">
                                                    <TextBlock Classes="label" Grid.Column="0"
                                                               Text="{DynamicResource Str.Tool.LanguageServers.Transport}" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Classes="machine" Text="{CompiledBinding Transport}" />
                                                        <TextBlock Classes="machine" Opacity="0.8"
                                                                   IsVisible="{CompiledBinding HasEndpoint}"
                                                                   Text="{CompiledBinding Endpoint}" />
                                                    </StackPanel>
                                                </Grid>

                                                <Grid ColumnDefinitions="96,*">
                                                    <TextBlock Classes="label" Grid.Column="0"
                                                               Text="{DynamicResource Str.Tool.LanguageServers.Claims}" />
                                                    <TextBlock Grid.Column="1" Classes="machine" Text="{CompiledBinding Claims}" />
                                                </Grid>

                                                <Grid ColumnDefinitions="96,*">
                                                    <TextBlock Classes="label" Grid.Column="0"
                                                               Text="{DynamicResource Str.Tool.LanguageServers.Priority}" />
                                                    <TextBlock Grid.Column="1" Classes="machine" Text="{CompiledBinding Priority}" />
                                                </Grid>

                                                <Grid ColumnDefinitions="96,*">
                                                    <TextBlock Classes="label" Grid.Column="0"
                                                               Text="{DynamicResource Str.Tool.LanguageServers.Status}" />
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                        <TextBlock Text="{CompiledBinding State}" FontWeight="Bold" />
                                                        <TextBlock Opacity="0.7" Text="{CompiledBinding Age}" />
                                                    </StackPanel>
                                                </Grid>

                                                <Grid ColumnDefinitions="96,*" IsVisible="{CompiledBinding HasReportedIdentity}">
                                                    <TextBlock Classes="label" Grid.Column="0"
                                                               Text="{DynamicResource Str.Tool.LanguageServers.ReportedBy}" />
                                                    <TextBlock Grid.Column="1" Classes="machine" Text="{CompiledBinding ReportedBy}" />
                                                </Grid>

                                                <!-- How far the last attempt got. The valuable half of #259: every failure path below converges
                                                     on "no connection", and which of five things happened is otherwise unrecoverable. -->
                                                <StackPanel IsVisible="{CompiledBinding HasChain}" Margin="0,6,0,0" Spacing="1">
                                                    <TextBlock FontWeight="Bold" Opacity="0.8"
                                                               Text="{DynamicResource Str.Tool.LanguageServers.HowFar}" />
                                                    <ItemsControl ItemsSource="{CompiledBinding Chain}" Margin="8,2,0,0">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="ls:LanguageServerStepViewModel">
                                                                <Grid ColumnDefinitions="16,150,70,*">
                                                                    <!-- Glyph rather than a word, so the break is found by shape, not by reading. -->
                                                                    <TextBlock Grid.Column="0" Classes="machine" Text="{CompiledBinding Marker}" />
                                                                    <TextBlock Grid.Column="1" Text="{CompiledBinding Stage}" />
                                                                    <TextBlock Grid.Column="2" Classes="machine" Opacity="0.6"
                                                                               Text="{CompiledBinding Elapsed}" />
                                                                    <TextBlock Grid.Column="3" Classes="machine"
                                                                               IsVisible="{CompiledBinding HasDetail}"
                                                                               Text="{CompiledBinding Detail}" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <!-- Said explicitly, because the registry records this as Failed and it is not a failure. -->
                                                    <TextBlock Margin="8,2,0,0" TextWrapping="Wrap" Opacity="0.8"
                                                               IsVisible="{CompiledBinding WasCancelled}"
                                                               Text="{DynamicResource Str.Tool.LanguageServers.WasCancelled}" />
                                                </StackPanel>

                                                <!-- Requests refused because the server never advertised them. Correct, deliberate, and otherwise
                                                     indistinguishable from the feature being broken. -->
                                                <Grid ColumnDefinitions="96,*" IsVisible="{CompiledBinding HasDeclined}" Margin="0,4,0,0">
                                                    <TextBlock Classes="label" Grid.Column="0"
                                                               Text="{DynamicResource Str.Tool.LanguageServers.Declined}" />
                                                    <ItemsControl Grid.Column="1" ItemsSource="{CompiledBinding Declined}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate><TextBlock Classes="machine" Text="{CompiledBinding}" /></DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Grid>

                                                <Grid ColumnDefinitions="96,*" IsVisible="{CompiledBinding ShowsDocumentCount}">
                                                    <TextBlock Classes="label" Grid.Column="0"
                                                               Text="{DynamicResource Str.Tool.LanguageServers.Documents}" />
                                                    <TextBlock Grid.Column="1" Classes="machine" Text="{CompiledBinding OpenDocumentCount}" />
                                                </Grid>

                                                <Grid ColumnDefinitions="96,*" IsVisible="{CompiledBinding HasWorkspaceRoot}">
                                                    <TextBlock Classes="label" Grid.Column="0"
                                                               Text="{DynamicResource Str.Tool.LanguageServers.WorkspaceRoot}" />
                                                    <TextBlock Grid.Column="1" Classes="machine" Text="{CompiledBinding WorkspaceRoot}" />
                                                </Grid>
                                                <!-- The two derived lines. These are the whole point for a server
                                                     that answers the handshake and then serves nothing: a bare
                                                     "Running" reports that as success. -->
                                                <TextBlock TextWrapping="Wrap" Margin="0,4,0,0"
                                                           IsVisible="{CompiledBinding AdvertisedNothing}"
                                                           Text="{DynamicResource Str.Tool.LanguageServers.AdvertisedNothing}" />
                                                <TextBlock TextWrapping="Wrap"
                                                           IsVisible="{CompiledBinding SendingNothing}"
                                                           Text="{DynamicResource Str.Tool.LanguageServers.SendingNothing}" />

                                                <!-- THE WINDOW'S FIRST INTERACTIVITY OF ANY KIND, and it
                                                     belongs here rather than in the inspector: this is the
                                                     list of servers, and arming is a per-server decision
                                                     about one of them.

                                                     Envelopes are recorded either way. What this governs is
                                                     content, which is the only part with a privacy cost and
                                                     the only part large enough to have a memory one. -->
                                                <DockPanel Margin="0,6,0,0">
                                                    <!-- OFFERED WHETHER OR NOT THE SERVER IS ARMED.
                                                         Envelopes are recorded unconditionally, so an
                                                         unarmed connection still answers "was it even sent,
                                                         and what came back" — and the moment somebody most
                                                         wants that answer is a server that has failed,
                                                         which is exactly when they will not have armed
                                                         it. -->
                                                    <Button DockPanel.Dock="Right"
                                                            Command="{CompiledBinding ShowMessagesCommand}"
                                                            Content="{DynamicResource Str.Tool.LanguageServers.ShowMessages}" />

                                                    <CheckBox VerticalAlignment="Center"
                                                              IsChecked="{CompiledBinding IsArmed}"
                                                              Content="{DynamicResource Str.Tool.LanguageServers.KeepBodies}" />
                                                </DockPanel>

                                                <Expander IsVisible="{CompiledBinding HasCapabilities}"
                                                          Margin="0,4,0,0"
                                                          Header="{DynamicResource Str.Tool.LanguageServers.Advertised}">
                                                    <SelectableTextBlock Classes="machine" FontSize="11"
                                                                         Text="{CompiledBinding CapabilitiesJson}" />
                                                </Expander>

                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Configuration problems: entries that never became connections at all, so they can appear
                 nowhere above. An entry that failed to parse and one that was never written are otherwise
                 the same observable state. -->
            <StackPanel IsVisible="{CompiledBinding HasProblems}" Spacing="4">
                <TextBlock Text="{DynamicResource Str.Tool.LanguageServers.Problems}"
                           FontWeight="Bold" FontSize="14" />
                <ItemsControl ItemsSource="{CompiledBinding Problems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Message renders verbatim: it already names the file, the reason, and for a
                                 JSON fault the pointer and line. Rewording it would lose all three. -->
                            <SelectableTextBlock Classes="machine" FontSize="11" Margin="0,0,0,4"
                                                 Text="{CompiledBinding Message}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Opacity="0.7" TextWrapping="Wrap"
                           Text="{DynamicResource Str.Tool.LanguageServers.RestartNote}" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
