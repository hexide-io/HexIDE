<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ls="clr-namespace:HexIDE.Tools.LanguageServers"
             x:Class="HexIDE.Tools.LanguageServers.LanguageServerEditorView"
             x:DataType="ls:LanguageServerEditorViewModel">
    <Grid RowDefinitions="*,Auto" RowSpacing="8">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="8">
                <TextBlock Text="{DynamicResource Str.Tool.LanguageServers.Editor.Help}" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{CompiledBinding Fields}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="ls:LanguageServerFieldViewModel">
                            <StackPanel Margin="0,3" IsVisible="{CompiledBinding IsVisible}">
                                <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{CompiledBinding Name}" /><TextBlock Text="JSON" IsVisible="{CompiledBinding IsJson}" Opacity="0.7" /></StackPanel>
                                <TextBox Text="{CompiledBinding Text, Mode=TwoWay}" IsReadOnly="{CompiledBinding IsReadOnly}" IsVisible="{CompiledBinding !HasChoices}"
                                         AutomationProperties.Name="{CompiledBinding Name}" />
                                <ComboBox ItemsSource="{CompiledBinding Choices}" SelectedItem="{CompiledBinding Text, Mode=TwoWay}"
                                          IsVisible="{CompiledBinding HasChoices}" HorizontalAlignment="Stretch"
                                          AutomationProperties.Name="{CompiledBinding Name}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Spacing="4">
            <!-- Capped, so a long command line scrolls here instead of squeezing the fields out of view. -->
            <ScrollViewer x:Name="Summary" MaxHeight="72" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="4">
                    <SelectableTextBlock Text="{CompiledBinding Problems}" TextWrapping="Wrap" />
                    <TextBlock Text="{DynamicResource Str.Tool.LanguageServers.Editor.Command}" FontWeight="Bold" />
                    <SelectableTextBlock Text="{CompiledBinding Preview}" TextWrapping="Wrap" FontFamily="Courier New" />
                </StackPanel>
            </ScrollViewer>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="{DynamicResource Str.Tool.LanguageServers.Editor.Save}" Command="{CompiledBinding SaveCommand}" />
                <Button IsCancel="True" Content="{DynamicResource Str.Dialog.MessageBox.Button.Cancel}" Command="{CompiledBinding CancelCommand}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
