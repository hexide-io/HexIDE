<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tools="clr-namespace:HexIDE.Tools"
             x:Class="HexIDE.Tools.FindReferencesToolView"
             x:DataType="tools:FindReferencesToolViewModel">
    <ListBox ItemsSource="{CompiledBinding Rows}" SelectedItem="{CompiledBinding SelectedRow, Mode=TwoWay}"
             DoubleTapped="OnDoubleTapped"
             AutomationProperties.AutomationId="FindReferences.Results">
        <ListBox.Styles>
            <Style Selector="ListBoxItem">
                <Setter Property="AutomationProperties.Name" Value="{CompiledBinding AccessibleName}" x:DataType="tools:ReferenceRow" />
            </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
            <DataTemplate x:DataType="tools:ReferenceRow">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{CompiledBinding Module}" FontWeight="Bold" />
                    <TextBlock Text="{CompiledBinding Line}" />
                    <TextBlock FontFamily="monospace"><Run Text="{CompiledBinding Before}" /><Run Text="{CompiledBinding Highlight}" FontWeight="Bold" /><Run Text="{CompiledBinding After}" /></TextBlock>
                </StackPanel>
            </DataTemplate>
        </ListBox.ItemTemplate>
    </ListBox>
</UserControl>
