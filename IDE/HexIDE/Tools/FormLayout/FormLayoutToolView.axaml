<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:tools="clr-namespace:HexIDE.Tools"
             xmlns:HexIDE="clr-namespace:HexIDE"
             xmlns:commonControls="clr-namespace:Classic.CommonControls;assembly=Classic.CommonControls.Avalonia"
             xmlns:controls="clr-namespace:HexIDE.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="tools:FormLayoutToolViewModel"
             x:Class="HexIDE.Tools.FormLayoutToolView">
    <ClassicBorderDecorator BorderStyle="Sunken" BorderThickness="2"
                            Background="{DynamicResource {x:Static commonControls:SystemColors.WindowBrushKey}}"
                            Padding="20">
        <controls:ProportionPanel Proportion="{CompiledBinding ScreenAspectRatio}">
            <DockPanel>
                <ClassicBorderDecorator BorderStyle="Raised"
                                        BorderThickness="2"
                                        DockPanel.Dock="Bottom"
                                        Height="8" Margin="55,-2"
                                        Background="{DynamicResource {x:Static commonControls:SystemColors.ControlBrushKey}}" />

                <Border BorderThickness="1"
                        BorderBrush="{DynamicResource {x:Static commonControls:SystemColors.ControlDarkBrushKey}}">
                    <ClassicBorderDecorator BorderStyle="Raised"
                                            BorderThickness="2"
                                            Background="{DynamicResource {x:Static commonControls:SystemColors.ControlBrushKey}}"
                                            Padding="10,6">
                        <ClassicBorderDecorator BorderStyle="Sunken" BorderThickness="3"
                                                Background="{DynamicResource {x:Static commonControls:SystemColors.DesktopBrushKey}}">
                        <Canvas x:Name="ScreenCanvas" ClipToBounds="True">
                            <Border Canvas.Left="{CompiledBinding ThumbLeft}"
                                    Canvas.Top="{CompiledBinding ThumbTop}"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource {x:Static commonControls:SystemColors.ControlTextBrushKey}}"
                                    Width="{CompiledBinding ThumbWidth}"
                                    Height="{CompiledBinding ThumbHeight}"
                                    Padding="1">
                                <Border BorderThickness="1"
                                        BorderBrush="{DynamicResource {x:Static commonControls:SystemColors.ControlTextBrushKey}}">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1" Background="Gray"
                                                BorderBrush="{DynamicResource {x:Static commonControls:SystemColors.ControlTextBrushKey}}"
                                                Height="4" />
                                        <Border Background="White">
                                            <TextBlock Text="{DynamicResource Str.Tool.FormLayout.Preview.FormName}" />
                                        </Border>
                                    </DockPanel>
                                </Border>
                            </Border>
                        </Canvas>
                    </ClassicBorderDecorator>
                    </ClassicBorderDecorator>
                </Border>
            </DockPanel>
        </controls:ProportionPanel>
    </ClassicBorderDecorator>
</UserControl>