<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:locals="clr-namespace:HexIDE.Tools"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="locals:LocalsToolViewModel"
             x:Class="HexIDE.Tools.LocalsToolView">
    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,5,*">

        <TextBox IsEnabled="False" Text="{DynamicResource Str.Tool.Locals.ContextReady}"/>
        <Button Grid.Column="1" IsEnabled="False" Content="{DynamicResource Str.Tool.Locals.Ellipsis}" />

        <DataGrid Grid.Row="2" Grid.ColumnSpan="2" VerticalScrollBarVisibility="Visible">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{DynamicResource Str.Tool.Locals.Column.Expression}" Width="*" />
                <DataGridTextColumn Header="{DynamicResource Str.Tool.Locals.Column.Value}" Width="*" />
                <DataGridTextColumn Header="{DynamicResource Str.Tool.Locals.Column.Type}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
