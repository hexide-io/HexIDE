<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:tools="clr-namespace:HexIDE.Tools"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="tools:WatchesToolViewModel"
             x:Class="HexIDE.Tools.WatchesToolView">
    <DataGrid VerticalScrollBarVisibility="Visible">
        <DataGrid.Columns>
            <DataGridTextColumn Header="{DynamicResource Str.Tool.Watches.Column.Expression}" Width="*" />
            <DataGridTextColumn Header="{DynamicResource Str.Tool.Watches.Column.Value}" Width="*" />
            <DataGridTextColumn Header="{DynamicResource Str.Tool.Watches.Column.Type}" Width="*" />
            <DataGridTextColumn Header="{DynamicResource Str.Tool.Watches.Column.Context}" Width="*" />
        </DataGrid.Columns>
    </DataGrid>
</UserControl>
