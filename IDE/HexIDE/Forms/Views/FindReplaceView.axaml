<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HexIDE.Forms.ViewModels"
             xmlns:converters="clr-namespace:HexIDE.Converters"
             x:Class="HexIDE.Forms.Views.FindReplaceView"
             x:DataType="vm:FindReplaceViewModel">

    <DockPanel Margin="8" LastChildFill="False">

        <!-- Right-side buttons -->
        <StackPanel DockPanel.Dock="Right" MinWidth="80" Margin="8,0,0,0" Spacing="4">
            <Button Content="{DynamicResource Str.Dialog.FindReplace.Button.FindNext}" Command="{CompiledBinding FindNextCommand}" IsDefault="True"
                    HorizontalContentAlignment="Center" HorizontalAlignment="Stretch" />
            <Button Content="{DynamicResource Str.Dialog.FindReplace.Button.Replace}" Command="{CompiledBinding ReplaceOneCommand}"
                    IsVisible="{CompiledBinding ShowReplace}"
                    HorizontalContentAlignment="Center" HorizontalAlignment="Stretch" />
            <Button Content="{DynamicResource Str.Dialog.FindReplace.Button.ReplaceAll}" Command="{CompiledBinding ReplaceAllCommand}"
                    IsVisible="{CompiledBinding ShowReplace}"
                    HorizontalContentAlignment="Center" HorizontalAlignment="Stretch" />
            <Button Content="{DynamicResource Str.Dialog.FindReplace.Button.Cancel}" Command="{CompiledBinding CancelCommand}" IsCancel="True"
                    HorizontalContentAlignment="Center" HorizontalAlignment="Stretch" />
        </StackPanel>

        <!-- Main content -->
        <StackPanel DockPanel.Dock="Left" MinWidth="320" MaxWidth="520">

            <!-- One grid, so the boxes line up after the longest caption, whatever the language (#3385). -->
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto">

                <!-- Find What. Both boxes hold code, so they read left to right whatever the IDE's language (#1944). -->
                <!-- Each box is named by its caption, without the access-key underscore, so a screen reader and the automation
                     tree know which box takes what (#2717). -->
                <TextBlock x:Name="FindWhatLabel" MinWidth="69" Margin="0,0,6,0" Text="{DynamicResource Str.Dialog.FindReplace.Label.FindWhat}" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Classes="dialogInitialFocus" Text="{CompiledBinding SearchText, Mode=TwoWay}" FlowDirection="LeftToRight"
                         AutomationProperties.Name="{CompiledBinding #FindWhatLabel.Text, Converter={x:Static converters:AccessKeyNameConverter.Instance}}" />

                <!-- Replace With (conditional) -->
                <TextBlock x:Name="ReplaceWithLabel" Grid.Row="1" Margin="0,6,6,0" IsVisible="{CompiledBinding ShowReplace}" Text="{DynamicResource Str.Dialog.FindReplace.Label.ReplaceWith}" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" IsVisible="{CompiledBinding ShowReplace}" Text="{CompiledBinding ReplaceText, Mode=TwoWay}" FlowDirection="LeftToRight"
                         AutomationProperties.Name="{CompiledBinding #ReplaceWithLabel.Text, Converter={x:Static converters:AccessKeyNameConverter.Instance}}" />

                <!-- Search scope -->
                <TextBlock x:Name="SearchLabel" Grid.Row="2" Margin="0,6,6,0" Text="{DynamicResource Str.Dialog.FindReplace.Label.Search}" VerticalAlignment="Center" />
                <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,6,0,0" ItemsSource="{CompiledBinding ScopeItems}"
                          AutomationProperties.Name="{CompiledBinding #SearchLabel.Text, Converter={x:Static converters:AccessKeyNameConverter.Instance}}"
                          SelectedIndex="{CompiledBinding SelectedScopeIndex, Mode=TwoWay}"
                          HorizontalAlignment="Stretch" />

                <!-- Direction -->
                <TextBlock Grid.Row="3" Margin="0,8,6,0" Text="{DynamicResource Str.Dialog.FindReplace.Label.Direction}" VerticalAlignment="Center" />
                <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" Orientation="Horizontal" Spacing="12">
                    <RadioButton Content="{DynamicResource Str.Dialog.FindReplace.Direction.Up}" GroupName="Direction"
                                 IsChecked="{CompiledBinding Direction, Converter={x:Static vm:FindDirectionConverters.IsUp}}" />
                    <RadioButton Content="{DynamicResource Str.Dialog.FindReplace.Direction.Down}" GroupName="Direction"
                                 IsChecked="{CompiledBinding Direction, Converter={x:Static vm:FindDirectionConverters.IsDown}}" />
                </StackPanel>
            </Grid>

            <!-- Options -->
            <StackPanel Spacing="2" Margin="0,2,0,0">

                <CheckBox Content="{DynamicResource Str.Dialog.FindReplace.Option.MatchCase}" IsChecked="{CompiledBinding MatchCase}" />
                <CheckBox Content="{DynamicResource Str.Dialog.FindReplace.Option.WholeWordOnly}" IsChecked="{CompiledBinding WholeWordOnly}" />
                <CheckBox Content="{DynamicResource Str.Dialog.FindReplace.Option.UsePatternMatching}" IsChecked="{CompiledBinding UsePatternMatching}" />
            </StackPanel>

        </StackPanel>

    </DockPanel>
</UserControl>
