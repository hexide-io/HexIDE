<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:HexIDE.Forms.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="viewModels:AddProcedureViewModel"
             MinWidth="278"
             x:Class="HexIDE.Forms.Views.AddProcedureView">
    <Border Margin="12,18,15,13">

        <Grid ColumnDefinitions="*,10,75">

            <StackPanel Spacing="7">

                <DockPanel>
                    <TextBlock VerticalAlignment="Center" Text="{DynamicResource Str.Dialog.AddProcedure.NameLabel}" />
                    <TextBox Text="{CompiledBinding Name}" Name="NameBox" />
                </DockPanel>

                <HeaderedContentControl Header="{DynamicResource Str.Dialog.AddProcedure.Type.Header}">
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,7,Auto" Margin="0,8,0,5">
                        <RadioButton Grid.Row="0" Grid.Column="0" IsChecked="{CompiledBinding IsSub} " GroupName="Type" Content="{DynamicResource Str.Dialog.AddProcedure.Type.Sub}" />
                        <RadioButton Grid.Row="0" Grid.Column="1" IsChecked="{CompiledBinding IsProperty} " GroupName="Type" Content="{DynamicResource Str.Dialog.AddProcedure.Type.Property}" />
                        <RadioButton Grid.Row="2" Grid.Column="0" IsChecked="{CompiledBinding IsFunction} " GroupName="Type" Content="{DynamicResource Str.Dialog.AddProcedure.Type.Function}" />
                        <RadioButton Grid.Row="2" Grid.Column="1" IsChecked="{CompiledBinding IsEvent} " GroupName="Type" Content="{DynamicResource Str.Dialog.AddProcedure.Type.Event}" />
                    </Grid>
                </HeaderedContentControl>

                <HeaderedContentControl Header="{DynamicResource Str.Dialog.AddProcedure.Scope.Header}">
                    <Grid ColumnDefinitions="*,*" Margin="0,8,0,3" IsEnabled="{CompiledBinding !IsEvent}">
                        <RadioButton Grid.Row="0" Grid.Column="0" IsChecked="{CompiledBinding IsPublic}" GroupName="Scope" Content="{DynamicResource Str.Dialog.AddProcedure.Scope.Public}" />
                        <RadioButton Grid.Row="0" Grid.Column="1" IsChecked="{CompiledBinding IsPrivate}" GroupName="Scope" Content="{DynamicResource Str.Dialog.AddProcedure.Scope.Private}" />
                    </Grid>
                </HeaderedContentControl>

                <CheckBox IsChecked="{CompiledBinding AllLocalStatics}"
                          IsEnabled="{CompiledBinding !IsEvent}" Content="{DynamicResource Str.Dialog.AddProcedure.AllLocalStatics}" />

            </StackPanel>

            <StackPanel Grid.Column="2" Spacing="10">
                <Button Command="{CompiledBinding OkCommand}" Content="{DynamicResource Str.Dialog.AddProcedure.Ok}" />
                <Button Command="{CompiledBinding Cancel}" Content="{DynamicResource Str.Dialog.AddProcedure.Cancel}" />
            </StackPanel>

        </Grid>

    </Border>
</UserControl>
