<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:HexIDE.Converters"
             xmlns:vm="clr-namespace:HexIDE.Forms.ViewModels.Options"
             mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="300"
             x:DataType="vm:KeymapPageViewModel"
             x:Class="HexIDE.Forms.Views.Options.KeymapPageView">
    <HeaderedContentControl Header="{DynamicResource Str.Options.Keymap.Header}" Padding="10">
        <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto" RowSpacing="8">
            <DockPanel Grid.Row="0">
                <AccessText x:Name="KeymapLabel" VerticalAlignment="Center" Margin="0,0,10,0" Text="{DynamicResource Str.Options.Keymap.Label}" />
                <ComboBox ItemsSource="{CompiledBinding AvailableKeymaps}"
                          AutomationProperties.Name="{CompiledBinding #KeymapLabel.Text, Converter={x:Static converters:AccessKeyNameConverter.Instance}, ConverterParameter=TrimColon}"
                          SelectedItem="{CompiledBinding SelectedKeymap}"
                          HorizontalAlignment="Left"
                          Width="160" />
            </DockPanel>
            <TextBlock Grid.Row="6" Opacity="0.7" FontSize="11" TextWrapping="Wrap"
                       Text="{DynamicResource Str.Options.Keymap.AppliedHint}" />
            <TextBox AutomationProperties.Name="{DynamicResource Str.Tool.ObjectBrowser.Toolbar.Search}" Grid.Row="1" Text="{CompiledBinding SearchText}" PlaceholderText="{DynamicResource Str.Tool.ObjectBrowser.Toolbar.SearchPlaceholder}" />
            <ListBox Grid.Row="2" MinHeight="120" MaxHeight="260" ItemsSource="{CompiledBinding FilteredCommands}"
                     SelectedItem="{CompiledBinding SelectedCommand}" AutomationProperties.Name="{DynamicResource Str.Options.Keymap.Header}">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="AutomationProperties.Name" Value="{CompiledBinding AccessibleName}" x:DataType="vm:KeymapCommandViewModel" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:KeymapCommandViewModel">
                        <Grid ColumnDefinitions="2*,*,Auto" ColumnSpacing="10">
                            <TextBlock Text="{CompiledBinding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{CompiledBinding Id}" />
                            <TextBlock Grid.Column="1" Text="{CompiledBinding Gesture}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{CompiledBinding Gesture}" />
                            <TextBlock Grid.Column="2" Text="{CompiledBinding Source}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <WrapPanel Grid.Row="3" ItemSpacing="4" LineSpacing="4">
                <Button x:Name="SetButton" Content="{DynamicResource Str.Options.Keymap.Set}" Command="{CompiledBinding SetCommand}" />
                <Button x:Name="ClearButton" Content="{DynamicResource Str.Options.Keymap.Clear}" Command="{CompiledBinding ClearCommand}" />
                <Button x:Name="ResetButton" Content="{DynamicResource Str.LspArtifact.Reset}" Command="{CompiledBinding ResetCommand}" />
                <Button Content="{DynamicResource Str.Options.Shell.Buttons.ResetAll}" Command="{CompiledBinding ResetAllCommand}" />
                <Button Content="{DynamicResource Str.Options.Keymap.Import}" Command="{CompiledBinding ImportCommand}" />
                <Button Content="{DynamicResource Str.Options.Keymap.Export}" Command="{CompiledBinding ExportCommand}" />
            </WrapPanel>
            <StackPanel Grid.Row="4" Spacing="4">
                <TextBlock IsVisible="{CompiledBinding IsCapturing}" Text="{DynamicResource Str.Options.Keymap.Capture}" TextWrapping="Wrap" />
                <StackPanel IsVisible="{CompiledBinding HasConflict}" Spacing="4">
                    <TextBlock Text="{CompiledBinding Conflict}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="{DynamicResource Str.RevertGate.Keep}" Command="{CompiledBinding KeepCommand}" />
                        <Button Content="{DynamicResource Str.Options.Shell.Buttons.Cancel}" Command="{CompiledBinding CancelCaptureCommand}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
            <TextBlock Grid.Row="5" Text="{CompiledBinding Error}" TextWrapping="Wrap" />
        </Grid>
    </HeaderedContentControl>
</UserControl>
