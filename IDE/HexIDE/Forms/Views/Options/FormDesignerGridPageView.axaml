<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:HexIDE.Converters"
             xmlns:vm="clr-namespace:HexIDE.Forms.ViewModels.Options"
             mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="300"
             x:DataType="vm:FormDesignerGridPageViewModel"
             x:Class="HexIDE.Forms.Views.Options.FormDesignerGridPageView">
    <HeaderedContentControl Header="{DynamicResource Str.Options.Grid.GroupHeader}" Padding="10" VerticalAlignment="Top">
        <StackPanel Orientation="Vertical" Spacing="6">
            <CheckBox IsChecked="{CompiledBinding ShowGrid}" Content="{DynamicResource Str.Options.Grid.ShowGrid}" />
            <DockPanel Margin="20,0,0,0">
                <AccessText x:Name="GridWidthLabel" VerticalAlignment="Center" Width="80" Text="{DynamicResource Str.Options.Grid.Width}" />
                <TextBox Width="60" HorizontalAlignment="Left" Text="{CompiledBinding GridWidth}"
                         AutomationProperties.Name="{CompiledBinding #GridWidthLabel.Text, Converter={x:Static converters:AccessKeyNameConverter.Instance}}" />
            </DockPanel>
            <DockPanel Margin="20,0,0,0">
                <AccessText x:Name="GridHeightLabel" VerticalAlignment="Center" Width="80" Text="{DynamicResource Str.Options.Grid.Height}" />
                <TextBox Width="60" HorizontalAlignment="Left" Text="{CompiledBinding GridHeight}"
                         AutomationProperties.Name="{CompiledBinding #GridHeightLabel.Text, Converter={x:Static converters:AccessKeyNameConverter.Instance}}" />
            </DockPanel>
            <CheckBox IsChecked="{CompiledBinding AlignToGrid}" Content="{DynamicResource Str.Options.Grid.AlignControls}" />
        </StackPanel>
    </HeaderedContentControl>
</UserControl>
