<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:HexIDE.Forms.ViewModels"
             xmlns:common="clr-namespace:Classic.CommonControls;assembly=Classic.CommonControls.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="viewModels:FileConflictViewModel"
             Height="270"
             x:Class="HexIDE.Forms.Views.FileConflictView">
    <Design.DataContext>
        <viewModels:FileConflictViewModel/>
    </Design.DataContext>

    <Grid Margin="11,12,11,15" ColumnDefinitions="300,20,110">

        <DockPanel>
            <TextBlock TextWrapping="WrapWithOverflow" DockPanel.Dock="Top" Margin="0,0,0,10"
                       Text="{DynamicResource Str.Dialog.FileConflict.Prompt}" />

            <ListBox ItemsSource="{CompiledBinding Files}">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem:selected">
                        <Style Selector="^:not(:focus-within)">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource {x:Static common:SystemColors.HighlightTextBrushKey}}"/>
                            <Style Selector="^ /template/ Border#Bd">
                                <Setter Property="Background"
                                        Value="{DynamicResource {x:Static common:SystemColors.HighlightBrushKey}}"/>
                            </Style>
                        </Style>
                    </Style>
                </ListBox.Styles>
            </ListBox>
        </DockPanel>

        <StackPanel Grid.Column="2" Orientation="Vertical" Spacing="5">
            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Command="{CompiledBinding ReloadAll}"
                    Content="{DynamicResource Str.Dialog.FileConflict.Button.ReloadAll}" />
            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Command="{CompiledBinding KeepAll}"
                    Content="{DynamicResource Str.Dialog.FileConflict.Button.KeepAll}" />
        </StackPanel>

    </Grid>
</UserControl>
