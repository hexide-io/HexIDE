<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:HexIDE.Forms.ViewModels"
             mc:Ignorable="d" d:DesignWidth="440" d:DesignHeight="280"
             x:DataType="vm:AddinConsentDialogViewModel"
             x:Class="HexIDE.Forms.Views.AddinConsentDialog">
    <StackPanel Margin="16" Spacing="12" Width="420">

        <TextBlock Text="{DynamicResource Str.Dialog.AddinConsent.Title}" FontSize="15" FontWeight="Bold" />

        <StackPanel Spacing="2">
            <TextBlock>
                <Run Text="{CompiledBinding AddinTitle}" FontWeight="Bold" />
                <Run Text=" " /><Run Text="{CompiledBinding Version}" />
            </TextBlock>
            <TextBlock Text="{CompiledBinding PublisherLine}" />
            <!-- Subtle, IDE-rendered chain inspector (key fingerprints) — examine the certificate before deciding. -->
            <Button Content="{DynamicResource Str.Dialog.AddinConsent.TrustDetails}" Classes="link" Padding="0" Margin="0,2,0,0"
                    Background="Transparent" BorderThickness="0" HorizontalAlignment="Left"
                    FontSize="12"
                    IsVisible="{CompiledBinding CanViewTrustDetails}"
                    Command="{CompiledBinding ViewTrustDetailsCommand}" />
        </StackPanel>

        <!-- Distinct warning for an unsigned / developer-mode add-in. -->
        <Border IsVisible="{CompiledBinding IsUnsigned}"
                Background="{DynamicResource WarningBannerBackgroundBrush}"
                BorderBrush="{DynamicResource WarningBannerBorderBrush}" BorderThickness="1"
                CornerRadius="3" Padding="8">
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource WarningBannerForegroundBrush}"
                       Text="{DynamicResource Str.Dialog.AddinConsent.UnsignedWarning}" />
        </Border>

        <TextBlock TextWrapping="Wrap"
                   Text="{DynamicResource Str.Dialog.AddinConsent.AccessWarning}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="{DynamicResource Str.Dialog.AddinConsent.Block}" Command="{CompiledBinding BlockCommand}" MinWidth="84" />
            <Button Content="{DynamicResource Str.Dialog.AddinConsent.Allow}" Command="{CompiledBinding AllowCommand}" MinWidth="84" />
        </StackPanel>
    </StackPanel>
</UserControl>
