<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:visualDesigner="clr-namespace:HexIDE.VisualDesigner"
             xmlns:converters="clr-namespace:HexIDE.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="visualDesigner:MenuEditorViewModel"
             x:Class="HexIDE.VisualDesigner.MenuEditorView">
    <UserControl.Resources>
        <converters:StringMultiplierConverter x:Key="IndentConverter" String="...." />
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="Label">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>
    <Border Padding="5,8">
        <StackPanel Orientation="Vertical" Spacing="6">
            <Grid ColumnDefinitions="50,*,12,75" RowDefinitions="Auto,3,Auto,6,Auto">

                <Label Content="{DynamicResource Str.Dialog.MenuEditor.Caption}" Grid.Row="0" Grid.Column="0"/>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{CompiledBinding SelectedMenu.Caption}" />
                <Button Content="{DynamicResource Str.Dialog.MenuEditor.OK}" Command="{CompiledBinding Accept}" Grid.Row="0" Grid.Column="3" />

                <Label Content="{DynamicResource Str.Dialog.MenuEditor.Name}" Grid.Row="2" Grid.Column="0"/>
                <TextBox Grid.Row="2" Grid.Column="1" Text="{CompiledBinding SelectedMenu.Name}"/>
                <Button Content="{DynamicResource Str.Dialog.MenuEditor.Cancel}" Command="{CompiledBinding Cancel}" Grid.Row="2" Grid.Column="3" />

                <Label Content="{DynamicResource Str.Dialog.MenuEditor.Index}" Grid.Row="4" Grid.Column="0"/>
                <DockPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" LastChildFill="False">
                    <TextBox Width="40" />
                    <ComboBox DockPanel.Dock="Right" SelectedIndex="0" Width="125">
                        <ComboBoxItem Content="{DynamicResource Str.Dialog.MenuEditor.Shortcut.None}" />
                    </ComboBox>
                    <Label Content="{DynamicResource Str.Dialog.MenuEditor.Shortcut}" Margin="0,0,15,0" DockPanel.Dock="Right"/>
                </DockPanel>
            </Grid>
            <Grid ColumnDefinitions="*,*,*,*">
                <Label Content="{DynamicResource Str.Dialog.MenuEditor.HelpContextID}" Grid.Column="0"/>
                <TextBox Grid.Column="1" />
                <Label Content="{DynamicResource Str.Dialog.MenuEditor.NegotiatePosition}" Grid.Column="2"/>
                <ComboBox Grid.Column="3" SelectedIndex="0">
                    <ComboBoxItem Content="{DynamicResource Str.Dialog.MenuEditor.NegotiatePosition.None}" />
                </ComboBox>
            </Grid>
            <Grid ColumnDefinitions="*,*,*,*">
                <CheckBox Content="{DynamicResource Str.Dialog.MenuEditor.Checked}" IsChecked="{CompiledBinding SelectedMenu.IsChecked}" Grid.Column="0" />
                <CheckBox Content="{DynamicResource Str.Dialog.MenuEditor.Enabled}" IsChecked="{CompiledBinding SelectedMenu.IsEnable}" Grid.Column="1" />
                <CheckBox Content="{DynamicResource Str.Dialog.MenuEditor.Visible}" IsChecked="{CompiledBinding SelectedMenu.IsVisible}" Grid.Column="2" />
                <CheckBox Content="{DynamicResource Str.Dialog.MenuEditor.WindowList}" IsChecked="{CompiledBinding SelectedMenu.IsWindowsList}" Grid.Column="3" />
            </Grid>
            <Separator />
            <Grid ColumnDefinitions="18,5,18,5,18,5,18,14,68,7,68,7,68" Margin="9,0">

                <Button Grid.Column="0" Padding="0" Command="{CompiledBinding MoveLeft}">
                    <Path Data="{StaticResource Geo.Left}" Fill="{DynamicResource IconInk}" Stretch="Uniform" Width="9" Height="9" />
                </Button>
                <Button Grid.Column="2" Padding="0" Command="{CompiledBinding MoveRight}">
                    <Path Data="{StaticResource Geo.Right}" Fill="{DynamicResource IconInk}" Stretch="Uniform" Width="9" Height="9" />
                </Button>
                <Button Grid.Column="4" Padding="0" Command="{CompiledBinding MoveUp}">
                    <Path Data="{StaticResource Geo.Up}" Fill="{DynamicResource IconInk}" Stretch="Uniform" Width="9" Height="9" />
                </Button>
                <Button Grid.Column="6" Padding="0" Command="{CompiledBinding MoveDown}">
                    <Path Data="{StaticResource Geo.Bottom}" Fill="{DynamicResource IconInk}" Stretch="Uniform" Width="9" Height="9" />
                </Button>
                <Button Grid.Column="8" Command="{CompiledBinding Next}" Content="{DynamicResource Str.Dialog.MenuEditor.Next}" />
                <Button Grid.Column="10" Command="{CompiledBinding Insert}" Content="{DynamicResource Str.Dialog.MenuEditor.Insert}" />
                <Button Grid.Column="12" Command="{CompiledBinding Delete}" Content="{DynamicResource Str.Dialog.MenuEditor.Delete}" />
            </Grid>
            <ListBox Margin="3,0" Height="147" SelectedItem="{CompiledBinding SelectedMenu, Mode=TwoWay}"
                     ItemsSource="{CompiledBinding FlatMenu}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="visualDesigner:MenuViewModel">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="0,-3,0,0" Text="{CompiledBinding Indent, Converter={StaticResource IndentConverter}}" />
                            <TextBlock Text="{CompiledBinding Caption}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </Border>
</UserControl>
