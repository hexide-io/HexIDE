<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:HexIDE="clr-namespace:HexIDE"
             xmlns:dockSimple="clr-namespace:Dock.Avalonia.Themes.Simple;assembly=Dock.Avalonia.Themes.Simple"
             x:Class="HexIDE.App"
             RequestedThemeVariant="Light">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="Themes/Classic.axaml" />
                <ResourceInclude Source="Themes/IconGeometry.axaml" />
                <ResourceInclude Source="Controls/MDI/MDIWindow.axaml" />
                <ResourceInclude Source="Controls/MDI/MDIHost.axaml" />
                <ResourceInclude Source="Controls/ResizeAdorner.axaml" />
                <ResourceInclude Source="Controls/Properties/PropertyBox.axaml" />
                <ResourceInclude Source="avares://HexIDE.Runtime/BuiltinControls/VBTimer.axaml" />
                <ResourceInclude Source="avares://HexIDE.Runtime/BuiltinControls/VBLabel.axaml" />
                <ResourceInclude Source="avares://HexIDE.Runtime/BuiltinControls/Resources.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <SimpleTheme />
        <StyleInclude Source="avares://HexIDE/Themes/DialogButtons.axaml" />
        <StyleInclude Source="avares://HexIDE/Themes/IconDirection.axaml" />
        <StyleInclude Source="avares://HexIDE/Themes/CodeDirection.axaml" />
        <StyleInclude Source="avares://HexIDE/Themes/EditorLinks.axaml" />
        <StyleInclude Source="avares://HexIDE/Themes/TabSelection.axaml" />
        <StyleInclude Source="avares://HexIDE/Themes/MenuNavigation.axaml" />
        <dockSimple:DockSimpleTheme />
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Simple/AvaloniaEdit.xaml" />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Simple.xaml" />
        <StyleInclude Source="avares://HexIDE/Automation/AccessKeyNames.axaml" />

        <StyleInclude Source="avares://HexIDE/Themes/ToolChrome.axaml" />
        <StyleInclude Source="avares://HexIDE/Themes/DragPreview.axaml" />
    </Application.Styles>

    <Application.DataTemplates>
        <HexIDE:ViewLocator />
    </Application.DataTemplates>
</Application>
