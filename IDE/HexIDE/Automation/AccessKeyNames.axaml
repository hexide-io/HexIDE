<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:HexIDE.Controls"
        xmlns:converters="clr-namespace:HexIDE.Converters">
    <!--
        The automation name of a button-like control is what a person reads on it. A caption with an access
        key is named as displayed, without its "_" marker (#578). A button showing only an icon is named by its
        tooltip, which is the name a person sees; its peer would otherwise name it by the icon's type,
        "Avalonia.Controls.Shapes.Path", on every such button (#542). A style setter ranks below a local value,
        so a view that sets AutomationProperties.Name itself keeps it; anything else leaves the peer's own name.
    -->
    <Style Selector="Button, RepeatButton, ToggleButton, CheckBox, RadioButton">
        <Setter Property="AutomationProperties.Name">
            <MultiBinding Converter="{x:Static converters:AccessKeyNameConverter.Instance}">
                <Binding Path="$self.Content" />
                <Binding Path="$self.(ToolTip.Tip)" />
            </MultiBinding>
        </Setter>
    </Style>
    <!-- Name Dock's icon-only template parts at the control, so peers and path matching agree (#542). -->
    <Style Selector="ToolChromeControl /template/ Button#PART_MenuButton">
        <Setter Property="AutomationProperties.Name" Value="{DynamicResource Str.Dock.Menu}" />
    </Style>
    <Style Selector="ToolChromeControl /template/ Button#PART_PinButton">
        <Setter Property="AutomationProperties.Name" Value="{DynamicResource Str.Dock.Pin}" />
    </Style>
    <Style Selector="ToolChromeControl /template/ Button#PART_MaximizeRestoreButton">
        <Setter Property="AutomationProperties.Name" Value="{DynamicResource Str.Dock.MaximizeRestore}" />
    </Style>
    <Style Selector="ToolChromeControl /template/ Button#PART_CloseButton">
        <Setter Property="AutomationProperties.Name" Value="{DynamicResource Str.Dock.Close}" />
    </Style>
    <Style Selector="ScrollViewer#PART_ScrollViewer /template/ RepeatButton[HorizontalAlignment=Stretch][VerticalAlignment=Stretch][(Grid.Column)=0], ScrollViewer#PART_ScrollViewer /template/ RepeatButton[HorizontalAlignment=Left]">
        <Setter Property="AutomationProperties.Name" Value="{DynamicResource Str.Dock.ScrollLeft}" />
    </Style>
    <Style Selector="ScrollViewer#PART_ScrollViewer /template/ RepeatButton[HorizontalAlignment=Stretch][VerticalAlignment=Stretch][(Grid.Column)=2], ScrollViewer#PART_ScrollViewer /template/ RepeatButton[HorizontalAlignment=Right]">
        <Setter Property="AutomationProperties.Name" Value="{DynamicResource Str.Dock.ScrollRight}" />
    </Style>
    <Style Selector="ScrollViewer#PART_ScrollViewer /template/ RepeatButton[HorizontalAlignment=Stretch][VerticalAlignment=Stretch][(Grid.Row)=0], ScrollViewer#PART_ScrollViewer /template/ RepeatButton[VerticalAlignment=Top]">
        <Setter Property="AutomationProperties.Name" Value="{DynamicResource Str.Dock.ScrollUp}" />
    </Style>
    <Style Selector="ScrollViewer#PART_ScrollViewer /template/ RepeatButton[HorizontalAlignment=Stretch][VerticalAlignment=Stretch][(Grid.Row)=2], ScrollViewer#PART_ScrollViewer /template/ RepeatButton[VerticalAlignment=Bottom]">
        <Setter Property="AutomationProperties.Name" Value="{DynamicResource Str.Dock.ScrollDown}" />
    </Style>
    <Style Selector="DocumentTabStripItem /template/ ContentPresenter#PART_ClosePresenter Button, DocumentTabStripItem /template/ ContentPresenter#PART_CompactClosePresenter Button">
        <Setter Property="AutomationProperties.Name" Value="{DynamicResource Str.Automation.Close}" />
    </Style>
    <Style Selector="controls|MDICaptionButtons /template/ Button#PART_MinimizeButton">
        <Setter Property="AutomationProperties.Name" Value="{DynamicResource Str.Automation.Minimize}" />
    </Style>
    <Style Selector="controls|MDICaptionButtons /template/ Button#PART_RestoreButton">
        <Setter Property="AutomationProperties.Name" Value="{DynamicResource Str.Automation.MaximizeRestore}" />
    </Style>
    <Style Selector="controls|MDICaptionButtons /template/ Button#PART_CloseButton">
        <Setter Property="AutomationProperties.Name" Value="{DynamicResource Str.Automation.Close}" />
    </Style>
    <Style Selector="ComboBox /template/ ToggleButton#toggle">
        <Setter Property="AutomationProperties.Name" Value="{DynamicResource Str.Automation.ToggleList}" />
    </Style>
    <Style Selector="controls|PropertyFontBox /template/ Button#PART_OpenFontWindowButton">
        <Setter Property="AutomationProperties.Name" Value="{DynamicResource Str.Automation.ChooseFont}" />
    </Style>
    <Style Selector="controls|PropertyColorBox /template/ Button">
        <Setter Property="AutomationProperties.Name" Value="{DynamicResource Str.Automation.ChooseColor}" />
    </Style>
</Styles>
