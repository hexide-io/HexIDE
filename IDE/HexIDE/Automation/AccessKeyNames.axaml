<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:HexIDE.Converters">
    <!--
        The automation name of a control captioned with an access key is its caption as displayed, not the
        string with its "_" marker (#578). A style setter ranks below a local value, so a view that sets
        AutomationProperties.Name itself keeps it; content that is not a caption with a marker leaves the
        peer's own name in place.
    -->
    <Style Selector="Button, RepeatButton, ToggleButton, CheckBox, RadioButton">
        <Setter Property="AutomationProperties.Name"
                Value="{Binding $self.Content, Converter={x:Static converters:AccessKeyNameConverter.Instance}}" />
    </Style>
</Styles>
