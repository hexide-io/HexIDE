<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:HexIDE="clr-namespace:HexIDE"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="HexIDE.MainWindow"
        x:DataType="HexIDE:MainViewViewModel"
        Icon="/Icons/AppIcon/hexide.ico"
        ClosingBehavior="OwnerAndChildWindows"
        Title="{CompiledBinding WindowTitle}">
    <HexIDE:MainView x:Name="MainView" />
</Window>
