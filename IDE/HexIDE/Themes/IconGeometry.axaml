<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Theme-tinted neutral ink for command icons (resolves per RequestedThemeVariant). -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="IconInk" Color="#3A3D42" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="IconInk" Color="#D7DEEC" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Semantic colours (read on any background; deliberately NOT theme-tinted). -->
    <SolidColorBrush x:Key="IconRun"   Color="#2FA24B" />
    <SolidColorBrush x:Key="IconStop"  Color="#D6473F" />
    <SolidColorBrush x:Key="IconBreak" Color="#E0A22E" />

