<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dock="clr-namespace:Dock.Avalonia.Controls;assembly=Dock.Avalonia">
    <Style Selector="TabControl#TabProperties TabItem:selected, dock|DocumentTabStripItem:selected">
        <Setter Property="BorderThickness" Value="{DynamicResource TabSelectionBorderThickness}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeForegroundBrush}" />
    </Style>
</Styles>
