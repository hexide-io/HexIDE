<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Menu scroll buttons precede the items in SimpleTheme's template. Flyout opening uses tab
         navigation: skip the buttons there, while preserving pointer scrolling and explicit focus. -->
    <Style Selector="MenuFlyoutPresenter /template/ ScrollViewer /template/ RepeatButton, ContextMenu /template/ ScrollViewer /template/ RepeatButton, MenuItem /template/ ScrollViewer /template/ RepeatButton">
        <Setter Property="IsTabStop" Value="False" />
    </Style>
</Styles>
