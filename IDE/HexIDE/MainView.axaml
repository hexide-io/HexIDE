                        <Separator />
                        <ToggleButton Width="22" Height="22" Padding="3" ToolTip.Tip="{DynamicResource Str.Toolbar.Tip.LockControls}"
                                     AutomationProperties.AutomationId="FormEditor.LockControls"
                                     Command="{x:Static vb:ApplicationCommands.LockControlsCommand}"
                                     IsChecked="{CompiledBinding FocusedProjectUtil.FocusedForm.LockControls, Mode=OneWay}">
                            <Path Data="{StaticResource Geo.Lockcontrols}" Fill="{DynamicResource IconInk}" Width="16" Height="16" Stretch="Uniform" />
                        </ToggleButton>
                    </StackPanel>
                </ClassicBorderDecorator>
            </StackPanel>

            <!-- Status bar (Win98-style sunken panels) -->
            <ClassicBorderDecorator DockPanel.Dock="Bottom" BorderStyle="Raised" BorderThickness="1"
                                    Background="{DynamicResource {x:Static commonControls:SystemColors.ControlBrushKey}}"
                                    Height="22"
                                    AutomationProperties.AutomationId="StatusBar">
                <DockPanel Margin="2,1">
                    <!-- INS/OVR panel (rightmost) -->
                    <ClassicBorderDecorator DockPanel.Dock="Right" BorderStyle="Sunken" BorderThickness="1"
                                            Width="50" Margin="1,0,0,0">
                        <TextBlock Text="{CompiledBinding StatusBar.InsertMode,
                                          Converter={x:Static utils:StatusBarConverters.InsertModeConverter}}"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                   FontSize="11"
                                   Foreground="{DynamicResource {x:Static commonControls:SystemColors.WindowTextBrushKey}}" />
                    </ClassicBorderDecorator>
                    <!-- Ln / Col panel -->
                    <ClassicBorderDecorator DockPanel.Dock="Right" BorderStyle="Sunken" BorderThickness="1"
                                            Width="120" Margin="1,0,0,0">
                        <TextBlock VerticalAlignment="Center" Margin="4,0"
                                   FontSize="11"
                                   Foreground="{DynamicResource {x:Static commonControls:SystemColors.WindowTextBrushKey}}">
                            <TextBlock.Text>
                                <MultiBinding Converter="{x:Static utils:StatusBarConverters.LinColConverter}">
                                    <Binding Path="StatusBar.Line" />
                                    <Binding Path="StatusBar.Column" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </ClassicBorderDecorator>
                    <!-- Message panel (fills remaining space) -->
                    <ClassicBorderDecorator BorderStyle="Sunken" BorderThickness="1"
                                            Margin="0,0,1,0">
                        <TextBlock Text="{CompiledBinding StatusBar.Message}"
                                   VerticalAlignment="Center" Margin="4,0"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource {x:Static commonControls:SystemColors.WindowTextBrushKey}}" />
                    </ClassicBorderDecorator>
                </DockPanel>
            </ClassicBorderDecorator>

            <DockControl x:Name="DockControl" Layout="{Binding Layout}">
                <DockControl.Styles>
                    <Style Selector="ToolChromeControl /template/ Button#PART_MenuButton">
                        <Setter Property="IsVisible" Value="False" />
                    </Style>
                </DockControl.Styles>
            </DockControl>
        </DockPanel>

        <controls:MDIHostPanel Name="PART_ModalHost" IsVisible="{Binding #PART_ModalHost.Children.Count}">
            <Panel.Background>
                <VisualBrush TileMode="Tile" SourceRect="0,0,2,2" DestinationRect="0,0,2,2">
                    <VisualBrush.Visual>
                        <Canvas Width="2" Height="2" Background="Transparent">
                            <Rectangle Fill="{StaticResource {x:Static commonControls:SystemColors.ControlLightLightBrushKey}}" Width="1" Height="1" />
                            <Rectangle Fill="{StaticResource {x:Static commonControls:SystemColors.ControlLightLightBrushKey}}" Width="1" Height="1" Canvas.Left="1" Canvas.Top="1" />
                        </Canvas>
                    </VisualBrush.Visual>
                </VisualBrush>
            </Panel.Background>
        </controls:MDIHostPanel>
    </Panel>
</UserControl>