<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:commonControls="clr-namespace:Classic.CommonControls;assembly=Classic.CommonControls.Avalonia"
             xmlns:vb="clr-namespace:HexIDE"
             xmlns:utils="clr-namespace:HexIDE.Utils"
             xmlns:controls="clr-namespace:HexIDE.Controls"
             xmlns:input="clr-namespace:Avalonia.Labs.Input"
             xmlns:ide="clr-namespace:HexIDE.IDE;assembly=HexIDE.Core"
             xmlns:dockSettings="clr-namespace:Dock.Settings;assembly=Dock.Settings"
             xmlns:forms="clr-namespace:HexIDE.Forms.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1080" d:DesignHeight="551"
             x:DataType="vb:MainViewViewModel"
             x:Name="RootView"
             Design.DataContext="{x:Static vb:DISetup.DesignTimeRootViewModel}"
             x:Class="HexIDE.MainView">
    <input:CommandManager.CommandBindings>
        <input:CommandBinding Command="{x:Static vb:ApplicationCommands.NYICommand}"
                              ExecutingCommand="{CompiledBinding NYI}" />
        <input:CommandBinding Command="{x:Static vb:ApplicationCommands.ExitCommand}"
                              ExecutingCommand="{CompiledBinding Exit}" />
        <input:CommandBinding Command="{x:Static vb:ApplicationCommands.NewProjectCommand}"
                              ExecutingCommand="{CompiledBinding NewProject}"/>
        <input:CommandBinding Command="{x:Static vb:ApplicationCommands.AddProjectCommand}"
                              ExecutingCommand="{CompiledBinding AddProject}"/>
        <input:CommandBinding Command="{x:Static vb:ApplicationCommands.ProductOnWebCommand}"
                              Executed="ProductOnWeb"/>
        <input:CommandBinding Command="{x:Static vb:ApplicationCommands.AboutCommand}"
                              ExecutingCommand="{CompiledBinding About}" />
        <input:CommandBinding Command="{x:Static vb:ApplicationCommands.OpenOptionsCommand}"
                              ExecutingCommand="{CompiledBinding OpenOptions}" />
        <input:CommandBinding Command="{x:Static vb:ApplicationCommands.OpenProjectExplorerCommand}"
                              ExecutingCommand="{CompiledBinding OpenProjectExplorerTool}" />
        <input:CommandBinding Command="{x:Static vb:ApplicationCommands.OpenPropertiesCommand}"
                              ExecutingCommand="{CompiledBinding OpenPropertiesTool}" />
        <input:CommandBinding Command="{x:Static vb:ApplicationCommands.OpenFormLayoutCommand}"
                              ExecutingCommand="{CompiledBinding OpenFormLayoutTool}" />
        <input:CommandBinding Command="{x:Static vb:ApplicationCommands.OpenObjectBrowserCommand}"
                              ExecutingCommand="{CompiledBinding OpenObjectBrowserTool}" />
        <input:CommandBinding Command="{x:Static vb:ApplicationCommands.OpenToolBoxCommand}"
                              ExecutingCommand="{CompiledBinding OpenToolBox}" />
        <input:CommandBinding Command="{x:Static vb:ApplicationCommands.OpenImmediateCommand}"
                              ExecutingCommand="{CompiledBinding OpenImmediateTool}" />
        <input:CommandBinding Command="{x:Static vb:ApplicationCommands.OpenLocalsCommand}"
                              ExecutingCommand="{CompiledBinding OpenLocalsTool}" />
        <input:CommandBinding Command="{x:Static vb:ApplicationCommands.OpenWatchesCommand}"
                              ExecutingCommand="{CompiledBinding OpenWatchesTool}" />
        <input:CommandBinding Command="{x:Static vb:ApplicationCommands.OpenCallStackCommand}"
                              ExecutingCommand="{CompiledBinding OpenCallStackTool}" />
        <input:CommandBinding Command="{x:Static vb:ApplicationCommands.OpenColorPaletteCommand}"
                              ExecutingCommand="{CompiledBinding OpenColorPaletteTool}" />
        <input:CommandBinding Command="{x:Static vb:ApplicationCommands.ReopenClosedDocumentCommand}"
                              ExecutingCommand="{CompiledBinding ReopenClosedDocumentCommand}" />
        <input:CommandBinding Command="{x:Static vb:ApplicationCommands.ResetWindowLayoutCommand}"
                              ExecutingCommand="{CompiledBinding ResetWindowLayout}" />

        <input:CommandBinding Command="{x:Static vb:ApplicationCommands.StartDefaultProjectCommand}"
                              ExecutingCommand="{CompiledBinding StartDefaultProjectCommand}" />
        <input:CommandBinding Command="{x:Static vb:ApplicationCommands.StartDefaultProjectWithFullCompileCommand}"
                              ExecutingCommand="{CompiledBinding StartDefaultProjectWithFullCompileCommand}" />
        <input:CommandBinding Command="{x:Static vb:ApplicationCommands.BreakProjectCommand}"
                              ExecutingCommand="{CompiledBinding BreakProjectCommand}" />
        <input:CommandBinding Command="{x:Static vb:ApplicationCommands.EndProjectCommand}"
                              ExecutingCommand="{CompiledBinding EndProjectCommand}" />
        <input:CommandBinding Command="{x:Static vb:ApplicationCommands.RestartProjectCommand}"
                              ExecutingCommand="{CompiledBinding RestartProjectCommand}" />

        <input:CommandBinding Command="{x:Static vb:ApplicationCommands.OpenDataViewCommand}"
                              ExecutingCommand="{x:Static vb:ApplicationCommands.DisabledCommand}" />


        <input:CommandBinding Command="{x:Static vb:ApplicationCommands.SaveCommand}"
                              ExecutingCommand="{CompiledBinding SaveFormCommand}" />
        <input:CommandBinding Command="{x:Static vb:ApplicationCommands.SaveAsCommand}"
                              ExecutingCommand="{CompiledBinding SaveFormAsCommand}" />
        <input:CommandBinding Command="{x:Static vb:ApplicationCommands.SaveProjectCommand}"
                              ExecutingCommand="{CompiledBinding SaveProject}" />
        <input:CommandBinding Command="{x:Static vb:ApplicationCommands.SaveProjectAsCommand}"
                              ExecutingCommand="{CompiledBinding SaveProjectAsCommand}" />
        <input:CommandBinding Command="{x:Static vb:ApplicationCommands.OpenProjectCommand}"
                              ExecutingCommand="{CompiledBinding OpenProject}" />
        <input:CommandBinding Command="{x:Static vb:ApplicationCommands.MakeProjectCommand}"
                              ExecutingCommand="{CompiledBinding MakeProjectCommand}" />
        <input:CommandBinding Command="{x:Static vb:ApplicationCommands.RunWithVb6Command}"
                              ExecutingCommand="{CompiledBinding RunWithVb6Command}" />
        <input:CommandBinding Command="{x:Static vb:ApplicationCommands.MakeWithVb6Command}"
                              ExecutingCommand="{CompiledBinding MakeWithVb6Command}" />
        <input:CommandBinding Command="{x:Static vb:ApplicationCommands.RemoveProjectCommand}"
                              ExecutingCommand="{CompiledBinding RemoveProjectCommand}" />
        <input:CommandBinding Command="{x:Static vb:ApplicationCommands.MakeProjectGroupCommand}"
                              ExecutingCommand="{CompiledBinding MakeProjectGroupCommand}" />

        <input:CommandBinding Command="{x:Static vb:ApplicationCommands.StepIntoCommand}"
                              ExecutingCommand="{CompiledBinding StepInto}" />
        <input:CommandBinding Command="{x:Static vb:ApplicationCommands.StepOverCommand}"
                              ExecutingCommand="{CompiledBinding StepOver}" />
        <input:CommandBinding Command="{x:Static vb:ApplicationCommands.StepOutCommand}"
                              ExecutingCommand="{CompiledBinding StepOut}" />
        <input:CommandBinding Command="{x:Static vb:ApplicationCommands.RunToCursorCommand}"
                              ExecutingCommand="{CompiledBinding RunToCursorCommand}" />
        <input:CommandBinding Command="{x:Static vb:ApplicationCommands.AddWatchCommand}"
                              ExecutingCommand="{CompiledBinding AddWatch}" />
        <input:CommandBinding Command="{x:Static vb:ApplicationCommands.EditWatchCommand}"
                              ExecutingCommand="{CompiledBinding EditWatchCommand}" />
        <input:CommandBinding Command="{x:Static vb:ApplicationCommands.QuickWatchCommand}"
                              ExecutingCommand="{CompiledBinding QuickWatch}" />
        <input:CommandBinding Command="{x:Static vb:ApplicationCommands.ToggleBreakpointCommand}"
                              ExecutingCommand="{CompiledBinding ToggleBreakpointCommand}" />
        <input:CommandBinding Command="{x:Static vb:ApplicationCommands.ClearAllBreakpointsCommand}"
                              ExecutingCommand="{CompiledBinding ClearAllBreakpoints}" />
        <input:CommandBinding Command="{x:Static vb:ApplicationCommands.SetNextStatementCommand}"
                              ExecutingCommand="{CompiledBinding SetNextStatementCommand}" />
        <input:CommandBinding Command="{x:Static vb:ApplicationCommands.ShowNextStatementCommand}"
                              ExecutingCommand="{CompiledBinding ShowNextStatementCommand}" />

        <input:CommandBinding Command="{x:Static vb:ApplicationCommands.ProjectReferencesCommand}"
                              ExecutingCommand="{CompiledBinding ProjectReferencesCommand}" />
        <input:CommandBinding Command="{x:Static vb:ApplicationCommands.ProjectComponentsCommand}"
                              ExecutingCommand="{CompiledBinding ProjectComponentsCommand}" />
        <input:CommandBinding Command="{x:Static vb:ApplicationCommands.ProjectPropertiesCommand}"
                              ExecutingCommand="{CompiledBinding ProjectPropertiesCommand}" />
        <input:CommandBinding Command="{x:Static vb:ApplicationCommands.FindCommand}"
                              ExecutingCommand="{CompiledBinding FindInCodeCommand}" />
        <input:CommandBinding Command="{x:Static vb:ApplicationCommands.FindNextCommand}"
                              ExecutingCommand="{CompiledBinding FindNextInCodeCommand}" />
        <input:CommandBinding Command="{x:Static vb:ApplicationCommands.ReplaceCommand}"
                              ExecutingCommand="{CompiledBinding ReplaceInCodeCommand}" />
    </input:CommandManager.CommandBindings>
    <UserControl.Styles>
        <!-- A toolbar button shows only an icon, so its automation name fell back to the icon's type,
             "Avalonia.Controls.Shapes.Path", on every button. Its tooltip is the name a person sees. (#526) -->
        <Style Selector="ClassicBorderDecorator.toolbar :is(Button)">
            <Setter Property="AutomationProperties.Name" Value="{Binding $self.(ToolTip.Tip)}" />
        </Style>
    </UserControl.Styles>
    <Panel HorizontalAlignment="Left" VerticalAlignment="Top">
        <DockPanel>
            <StackPanel Background="{DynamicResource {x:Static commonControls:SystemColors.ControlBrushKey}}"
                        Orientation="Vertical" DockPanel.Dock="Top">
                <StackPanel.ContextFlyout>
                    <MenuFlyout>
                        <MenuItem Header="{DynamicResource Str.Toolbar.Standard}"    ToggleType="CheckBox" IsChecked="{CompiledBinding Settings.IsStandardToolbarVisible,   Mode=TwoWay}" />
                        <MenuItem Header="{DynamicResource Str.Toolbar.Edit}"        ToggleType="CheckBox" IsChecked="{CompiledBinding Settings.IsEditToolbarVisible,       Mode=TwoWay}" />
                        <MenuItem Header="{DynamicResource Str.Toolbar.Debug}"       ToggleType="CheckBox" IsChecked="{CompiledBinding Settings.IsDebugToolbarVisible,      Mode=TwoWay}" />
                        <MenuItem Header="{DynamicResource Str.Toolbar.FormEditor}"  IsChecked="{CompiledBinding Settings.IsFormEditorToolbarVisible,   Mode=TwoWay}" ToggleType="CheckBox" />
                        <Separator />
                        <MenuItem Header="{DynamicResource Str.Toolbar.Customize}" IsEnabled="False" />
                    </MenuFlyout>
                </StackPanel.ContextFlyout>
                <ClassicBorderDecorator x:Name="MainMenuHost" BorderStyle="ThinRaised" BorderThickness="1" DockPanel.Dock="Top" />
                <ClassicBorderDecorator BorderStyle="ThinRaised" BorderThickness="1" DockPanel.Dock="Top"
                                        IsVisible="{CompiledBinding Settings.IsStandardToolbarVisible}"
                                        HorizontalAlignment="Left"
                                        AutomationProperties.AutomationId="StandardToolbar"
                                        Classes="toolbar">
                    <StackPanel Orientation="Horizontal" Margin="0,1">
                        <Button Width="22" Height="22" Padding="3" ToolTip.Tip="{DynamicResource Str.Toolbar.Tip.AddProject}" x:Name="AddProjectButton" AutomationProperties.AutomationId="Standard.AddProject">
                            <Button.Flyout>
                                <MenuFlyout Opening="ProjectFlyoutOpening" />
                            </Button.Flyout>
                            <Path Data="{StaticResource Geo.Addproject}" Fill="{DynamicResource IconInk}" Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                        <Button Width="22" Height="22" Padding="3" ToolTip.Tip="{DynamicResource Str.Toolbar.Tip.AddForm}" AutomationProperties.AutomationId="Standard.AddForm">
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuItem Header="{DynamicResource Str.AddItem.Form}"               Command="{CompiledBinding AddFormCommand}"        utils:MenuUtils.MenuIcon="{StaticResource Geo.Addform}" />
                                    <MenuItem Header="{DynamicResource Str.AddItem.MDIForm}"           Command="{x:Static vb:ApplicationCommands.DisabledCommand}" utils:MenuUtils.MenuIcon="{StaticResource Geo.Addmdiform}" />
                                    <MenuItem Header="{DynamicResource Str.AddItem.Module}"             Command="{CompiledBinding AddModuleCommand}"      utils:MenuUtils.MenuIcon="{StaticResource Geo.Addmodule}" />
                                    <MenuItem Header="{DynamicResource Str.AddItem.ClassModule}"       Command="{CompiledBinding AddClassModuleCommand}" utils:MenuUtils.MenuIcon="{StaticResource Geo.Addclassmodule}" />
                                    <MenuItem Header="{DynamicResource Str.AddItem.UserControl}"       Command="{CompiledBinding AddUserControlCommand}" utils:MenuUtils.MenuIcon="{StaticResource Geo.Addusercontrol}" />
                                    <MenuItem Header="{DynamicResource Str.AddItem.PropertyPage}"      Command="{CompiledBinding AddPropertyPageCommand}" utils:MenuUtils.MenuIcon="{StaticResource Geo.Addpropertypage}" />
                                    <Separator />
                                    <MenuItem Header="{DynamicResource Str.AddItem.AddFile}"        Command="{CompiledBinding AddFileCommand}" />
                                </MenuFlyout>
                            </Button.Flyout>
                            <Path Data="{StaticResource Geo.Addform}" Fill="{DynamicResource IconInk}" Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                        <Button Width="22" Height="22" Padding="3" Command="{x:Static vb:ApplicationCommands.EditMenuCommand}" ToolTip.Tip="{DynamicResource Str.Toolbar.Tip.MenuEditor}" AutomationProperties.AutomationId="Standard.MenuEditor">
                            <Path Data="{StaticResource Geo.Menubar}" Fill="{DynamicResource IconInk}" Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                        <Separator />
                        <Button Width="22" Height="22" Padding="3" Command="{x:Static vb:ApplicationCommands.OpenProjectCommand}" ToolTip.Tip="{DynamicResource Str.Toolbar.Tip.OpenProject}" AutomationProperties.AutomationId="Standard.OpenProject">
                            <Path Data="{StaticResource Geo.Open}" Fill="{DynamicResource IconInk}" Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                        <Button Width="22" Height="22" Padding="3" Command="{x:Static vb:ApplicationCommands.SaveProjectCommand}" ToolTip.Tip="{DynamicResource Str.Toolbar.Tip.SaveProject}" AutomationProperties.AutomationId="Standard.SaveProject">
                            <Path Data="{StaticResource Geo.Save}" Fill="{DynamicResource IconInk}" Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                        <Separator />
                        <Button Width="22" Height="22" Padding="3" Command="{x:Static vb:ApplicationCommands.CutCommand}" ToolTip.Tip="{DynamicResource Str.Toolbar.Tip.Cut}" AutomationProperties.AutomationId="Standard.Cut">
                            <Path Data="{StaticResource Geo.Cut}" Fill="{DynamicResource IconInk}" Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                        <Button Width="22" Height="22" Padding="3" Command="{x:Static vb:ApplicationCommands.CopyCommand}" ToolTip.Tip="{DynamicResource Str.Toolbar.Tip.Copy}" AutomationProperties.AutomationId="Standard.Copy">
                            <Path Data="{StaticResource Geo.Copy}" Fill="{DynamicResource IconInk}" Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                        <Button Width="22" Height="22" Padding="3" Command="{x:Static vb:ApplicationCommands.PasteCommand}" ToolTip.Tip="{DynamicResource Str.Toolbar.Tip.Paste}" AutomationProperties.AutomationId="Standard.Paste">
                            <Path Data="{StaticResource Geo.Paste}" Fill="{DynamicResource IconInk}" Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                        <Button Width="22" Height="22" Padding="3" Command="{x:Static vb:ApplicationCommands.FindCommand}" ToolTip.Tip="{DynamicResource Str.Toolbar.Tip.Find}" AutomationProperties.AutomationId="Standard.Find">
                            <Path Data="{StaticResource Geo.Find}" Fill="{DynamicResource IconInk}" Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                        <Separator />
                        <Button Width="22" Height="22" Padding="3" Command="{x:Static vb:ApplicationCommands.UndoCommand}" ToolTip.Tip="{DynamicResource Str.Toolbar.Tip.Undo}" AutomationProperties.AutomationId="Standard.Undo">
                            <Path Data="{StaticResource Geo.Undo}" Fill="{DynamicResource IconInk}" Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                        <Button Width="22" Height="22" Padding="3" Command="{x:Static vb:ApplicationCommands.RedoCommand}" ToolTip.Tip="{DynamicResource Str.Toolbar.Tip.Redo}" AutomationProperties.AutomationId="Standard.Redo">
                            <Path Data="{StaticResource Geo.Redo}" Fill="{DynamicResource IconInk}" Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                        <Separator />
                        <Button Width="22" Height="22" Padding="3" Command="{x:Static vb:ApplicationCommands.StartDefaultProjectCommand}" ToolTip.Tip="{DynamicResource Str.Toolbar.Tip.Start}" AutomationProperties.AutomationId="Standard.Start">
                            <Path Classes="play" Data="{StaticResource Geo.Play}" Fill="{StaticResource IconRun}" Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                        <Button Width="22" Height="22" Padding="3" Command="{CompiledBinding BreakProjectCommand}" ToolTip.Tip="{DynamicResource Str.Toolbar.Tip.Break}" AutomationProperties.AutomationId="Standard.Break">
                            <Path Data="{StaticResource Geo.Pause}" Fill="{DynamicResource IconBreak}" Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                        <Button Width="22" Height="22" Padding="3" Command="{CompiledBinding EndProjectCommand}" ToolTip.Tip="{DynamicResource Str.Toolbar.Tip.End}" AutomationProperties.AutomationId="Standard.End">
                            <Path Data="{StaticResource Geo.Stop}" Fill="{StaticResource IconStop}" Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                        <Separator />
                        <Button Width="22" Height="22" Padding="3" Command="{x:Static vb:ApplicationCommands.OpenProjectExplorerCommand}" ToolTip.Tip="{DynamicResource Str.Toolbar.Tip.ProjectExplorer}" AutomationProperties.AutomationId="Standard.ProjectExplorer">
                            <Path Data="{StaticResource Geo.Projectexplorer}" Fill="{DynamicResource IconInk}" Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                        <Button Width="22" Height="22" Padding="3" Command="{x:Static vb:ApplicationCommands.OpenPropertiesCommand}" ToolTip.Tip="{DynamicResource Str.Toolbar.Tip.PropertiesWindow}" AutomationProperties.AutomationId="Standard.PropertiesWindow">
                            <Path Data="{StaticResource Geo.Properties}" Fill="{DynamicResource IconInk}" Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                        <Button Width="22" Height="22" Padding="3" Command="{x:Static vb:ApplicationCommands.OpenFormLayoutCommand}" ToolTip.Tip="{DynamicResource Str.Toolbar.Tip.FormLayoutWindow}" AutomationProperties.AutomationId="Standard.FormLayout">
                            <Path Data="{StaticResource Geo.Formlayout}" Fill="{DynamicResource IconInk}" Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                        <Button Width="22" Height="22" Padding="3" Command="{x:Static vb:ApplicationCommands.OpenObjectBrowserCommand}" ToolTip.Tip="{DynamicResource Str.Toolbar.Tip.ObjectBrowser}" AutomationProperties.AutomationId="Standard.ObjectBrowser">
                            <Path Data="{StaticResource Geo.Objectbrowser}" Fill="{DynamicResource IconInk}" Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                        <Button Width="22" Height="22" Padding="3" Command="{x:Static vb:ApplicationCommands.OpenToolBoxCommand}" ToolTip.Tip="{DynamicResource Str.Toolbar.Tip.Toolbox}" AutomationProperties.AutomationId="Standard.Toolbox">
                            <Path Data="{StaticResource Geo.Toolbox}" Fill="{DynamicResource IconInk}" Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                        <Button Width="22" Height="22" Padding="3" Command="{x:Static vb:ApplicationCommands.OpenDataViewCommand}" ToolTip.Tip="{DynamicResource Str.Toolbar.Tip.DataViewWindow}" AutomationProperties.AutomationId="Standard.DataView">
                            <Path Data="{StaticResource Geo.Dataview}" Fill="{DynamicResource IconInk}" Width="16" Height="16" Stretch="Uniform" />
                        </Button>

                        <Separator />
                        <Path Data="{StaticResource Geo.Position}" Fill="{DynamicResource IconInk}" Width="16" Height="16" Stretch="Uniform" />
                        <TextBlock VerticalAlignment="Center" Text="{CompiledBinding FocusedProjectUtil.FocusedComponentPosition}" />
                        <Border Width="50" />
                        <Path Data="{StaticResource Geo.Size}" Fill="{DynamicResource IconInk}" Width="16" Height="16" Stretch="Uniform" />
                        <TextBlock VerticalAlignment="Center" Text="{CompiledBinding FocusedProjectUtil.FocusedComponentSize}" />
                        <Border Width="20" />
                    </StackPanel>
                </ClassicBorderDecorator>
                <ClassicBorderDecorator BorderStyle="ThinRaised" BorderThickness="1" DockPanel.Dock="Top"
                                        IsVisible="{CompiledBinding Settings.IsEditToolbarVisible}"
                                        HorizontalAlignment="Left"
                                        AutomationProperties.AutomationId="EditToolbar"
                                        Classes="toolbar">
                    <StackPanel Orientation="Horizontal" Margin="0,1">
                        <Button Width="22" Height="22" Padding="3" Focusable="False" Command="{x:Static vb:ApplicationCommands.ListPropertiesMethodsCommand}" ToolTip.Tip="{DynamicResource Str.Toolbar.Tip.ListPropertiesMethods}" AutomationProperties.AutomationId="Edit.ListPropertiesMethods">
                            <Path Data="{StaticResource Geo.Listproperties}" Fill="{DynamicResource IconInk}" Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                        <Button Width="22" Height="22" Padding="3" Focusable="False" Command="{x:Static vb:ApplicationCommands.ListConstantsCommand}" ToolTip.Tip="{DynamicResource Str.Toolbar.Tip.ListConstants}" AutomationProperties.AutomationId="Edit.ListConstants">
                            <Path Data="{StaticResource Geo.Listconstants}" Fill="{DynamicResource IconInk}" Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                        <Button Width="22" Height="22" Padding="3" Focusable="False" Command="{x:Static vb:ApplicationCommands.QuickInfoCommand}" ToolTip.Tip="{DynamicResource Str.Toolbar.Tip.QuickInfo}" AutomationProperties.AutomationId="Edit.QuickInfo">
                            <Path Data="{StaticResource Geo.Quickinfo}" Fill="{DynamicResource IconInk}" Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                        <Button Width="22" Height="22" Padding="3" Focusable="False" Command="{x:Static vb:ApplicationCommands.ParameterInfoCommand}" ToolTip.Tip="{DynamicResource Str.Toolbar.Tip.ParameterInfo}" AutomationProperties.AutomationId="Edit.ParameterInfo">
                            <Path Data="{StaticResource Geo.Parameterinfo}" Fill="{DynamicResource IconInk}" Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                        <Button Width="22" Height="22" Padding="3" Focusable="False" Command="{x:Static vb:ApplicationCommands.CompleteWordCommand}" ToolTip.Tip="{DynamicResource Str.Toolbar.Tip.CompleteWord}" AutomationProperties.AutomationId="Edit.CompleteWord">
                            <Path Data="{StaticResource Geo.Completeword}" Fill="{DynamicResource IconInk}" Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                        <Separator />
                        <Button Width="22" Height="22" Padding="3" Focusable="False" Command="{x:Static vb:ApplicationCommands.IndentCommand}" ToolTip.Tip="{DynamicResource Str.Toolbar.Tip.Indent}" AutomationProperties.AutomationId="Edit.Indent">
                            <Path Data="{StaticResource Geo.Indent}" Fill="{DynamicResource IconInk}" Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                        <Button Width="22" Height="22" Padding="3" Focusable="False" Command="{x:Static vb:ApplicationCommands.OutdentCommand}" ToolTip.Tip="{DynamicResource Str.Toolbar.Tip.Outdent}" AutomationProperties.AutomationId="Edit.Outdent">
                            <Path Data="{StaticResource Geo.Outdent}" Fill="{DynamicResource IconInk}" Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                        <Separator />
                        <Button Width="22" Height="22" Padding="3" Focusable="False" Command="{x:Static vb:ApplicationCommands.ToggleBreakpointCommand}" ToolTip.Tip="{DynamicResource Str.Toolbar.Tip.ToggleBreakpoint}" AutomationProperties.AutomationId="Edit.ToggleBreakpoint">
                            <Path Data="{StaticResource Geo.Togglebreakpoint}" Fill="{DynamicResource IconStop}" Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                        <Separator />
                        <Button Width="22" Height="22" Padding="3" Focusable="False" Command="{x:Static vb:ApplicationCommands.ToggleBookmarkCommand}" ToolTip.Tip="{DynamicResource Str.Toolbar.Tip.ToggleBookmark}" AutomationProperties.AutomationId="Edit.ToggleBookmark">
                            <Path Data="{StaticResource Geo.Togglebookmark}" Fill="{DynamicResource IconInk}" Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                        <Button Width="22" Height="22" Padding="3" Focusable="False" Command="{x:Static vb:ApplicationCommands.NextBookmarkCommand}" ToolTip.Tip="{DynamicResource Str.Toolbar.Tip.NextBookmark}" AutomationProperties.AutomationId="Edit.NextBookmark">
                            <Path Data="{StaticResource Geo.Nextbookmark}" Fill="{DynamicResource IconInk}" Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                        <Button Width="22" Height="22" Padding="3" Focusable="False" Command="{x:Static vb:ApplicationCommands.PreviousBookmarkCommand}" ToolTip.Tip="{DynamicResource Str.Toolbar.Tip.PreviousBookmark}" AutomationProperties.AutomationId="Edit.PreviousBookmark">
                            <Path Data="{StaticResource Geo.Previousbookmark}" Fill="{DynamicResource IconInk}" Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                        <Button Width="22" Height="22" Padding="3" Focusable="False" Command="{x:Static vb:ApplicationCommands.ClearAllBookmarksCommand}" ToolTip.Tip="{DynamicResource Str.Toolbar.Tip.ClearAllBookmarks}" AutomationProperties.AutomationId="Edit.ClearAllBookmarks">
                            <Path Data="{StaticResource Geo.Clearallbookmarks}" Fill="{DynamicResource IconInk}" Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                    </StackPanel>
                </ClassicBorderDecorator>
                <ClassicBorderDecorator BorderStyle="ThinRaised" BorderThickness="1" DockPanel.Dock="Top"
                                        IsVisible="{CompiledBinding Settings.IsDebugToolbarVisible}"
                                        HorizontalAlignment="Left"
                                        AutomationProperties.AutomationId="DebugToolbar"
                                        Classes="toolbar">
                    <StackPanel Orientation="Horizontal" Margin="0,1">
                        <Button Width="22" Height="22" Padding="3" Command="{x:Static vb:ApplicationCommands.StartDefaultProjectCommand}" ToolTip.Tip="{DynamicResource Str.Toolbar.Tip.Start}" AutomationProperties.AutomationId="Debug.Start">
                            <Path Classes="play" Data="{StaticResource Geo.Play}" Fill="{StaticResource IconRun}" Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                        <Button Width="22" Height="22" Padding="3" Command="{CompiledBinding BreakProjectCommand}" ToolTip.Tip="{DynamicResource Str.Toolbar.Tip.Break}" AutomationProperties.AutomationId="Debug.Break">
                            <Path Data="{StaticResource Geo.Pause}" Fill="{DynamicResource IconBreak}" Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                        <Button Width="22" Height="22" Padding="3" Command="{CompiledBinding EndProjectCommand}" ToolTip.Tip="{DynamicResource Str.Toolbar.Tip.End}" AutomationProperties.AutomationId="Debug.End">
                            <Path Data="{StaticResource Geo.Stop}" Fill="{StaticResource IconStop}" Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                        <Separator />
                        <Button Width="22" Height="22" Padding="3" Command="{x:Static vb:ApplicationCommands.ToggleBreakpointCommand}" ToolTip.Tip="{DynamicResource Str.Toolbar.Tip.ToggleBreakpoint}" AutomationProperties.AutomationId="Debug.ToggleBreakpoint">
                            <Path Data="{StaticResource Geo.Togglebreakpoint}" Fill="{DynamicResource IconStop}" Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                        <Separator />
                        <Button Width="22" Height="22" Padding="3" Command="{x:Static vb:ApplicationCommands.StepIntoCommand}" ToolTip.Tip="{DynamicResource Str.Toolbar.Tip.StepInto}" AutomationProperties.AutomationId="Debug.StepInto">
                            <Path Data="{StaticResource Geo.Stepinto}" Fill="{DynamicResource IconInk}" Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                        <Button Width="22" Height="22" Padding="3" Command="{x:Static vb:ApplicationCommands.StepOverCommand}" ToolTip.Tip="{DynamicResource Str.Toolbar.Tip.StepOver}" AutomationProperties.AutomationId="Debug.StepOver">
                            <Path Data="{StaticResource Geo.Stepover}" Fill="{DynamicResource IconInk}" Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                        <Button Width="22" Height="22" Padding="3" Command="{x:Static vb:ApplicationCommands.StepOutCommand}" ToolTip.Tip="{DynamicResource Str.Toolbar.Tip.StepOut}" AutomationProperties.AutomationId="Debug.StepOut">
                            <Path Data="{StaticResource Geo.Stepout}" Fill="{DynamicResource IconInk}" Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                        <Separator />
                        <Button Width="22" Height="22" Padding="3" Command="{x:Static vb:ApplicationCommands.OpenLocalsCommand}" ToolTip.Tip="{DynamicResource Str.Toolbar.Tip.LocalsWindow}" AutomationProperties.AutomationId="Debug.LocalsWindow">
                            <Path Data="{StaticResource Geo.Localswindow}" Fill="{DynamicResource IconInk}" Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                        <Button Width="22" Height="22" Padding="3" Command="{x:Static vb:ApplicationCommands.OpenImmediateCommand}" ToolTip.Tip="{DynamicResource Str.Toolbar.Tip.ImmediateWindow}" AutomationProperties.AutomationId="Debug.ImmediateWindow">
                            <Path Data="{StaticResource Geo.Immediatewindow}" Fill="{DynamicResource IconInk}" Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                        <Button Width="22" Height="22" Padding="3" Command="{x:Static vb:ApplicationCommands.OpenWatchesCommand}" ToolTip.Tip="{DynamicResource Str.Toolbar.Tip.WatchWindow}" AutomationProperties.AutomationId="Debug.WatchWindow">
                            <Path Data="{StaticResource Geo.Watchwindow}" Fill="{DynamicResource IconInk}" Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                        <Separator />
                        <Button Width="22" Height="22" Padding="3" Command="{x:Static vb:ApplicationCommands.QuickWatchCommand}" ToolTip.Tip="{DynamicResource Str.Toolbar.Tip.QuickWatch}" AutomationProperties.AutomationId="Debug.QuickWatch">
                            <Path Data="{StaticResource Geo.Quickwatch}" Fill="{DynamicResource IconInk}" Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                        <Button Width="22" Height="22" Padding="3" Command="{x:Static vb:ApplicationCommands.OpenCallStackCommand}" ToolTip.Tip="{DynamicResource Str.Toolbar.Tip.CallStack}" AutomationProperties.AutomationId="Debug.CallStack">
                            <Path Data="{StaticResource Geo.Callstack}" Fill="{DynamicResource IconInk}" Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                    </StackPanel>
                </ClassicBorderDecorator>
                <ClassicBorderDecorator BorderStyle="ThinRaised" BorderThickness="1" DockPanel.Dock="Top"
                                        IsVisible="{CompiledBinding Settings.IsFormEditorToolbarVisible}"
                                        HorizontalAlignment="Left"
                                        AutomationProperties.AutomationId="FormEditorToolbar"
                                        Classes="toolbar">
                    <StackPanel Orientation="Horizontal" Margin="0,1">
                        <Button Width="22" Height="22" Padding="3" Command="{x:Static vb:ApplicationCommands.BringToFrontCommand}" ToolTip.Tip="{DynamicResource Str.Toolbar.Tip.BringToFront}" AutomationProperties.AutomationId="FormEditor.BringToFront">
                            <Path Data="{StaticResource Geo.Bringtofront}" Fill="{DynamicResource IconInk}" Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                        <Button Width="22" Height="22" Padding="3" Command="{x:Static vb:ApplicationCommands.SendToBackCommand}" ToolTip.Tip="{DynamicResource Str.Toolbar.Tip.SendToBack}" AutomationProperties.AutomationId="FormEditor.SendToBack">
                            <Path Data="{StaticResource Geo.Sendtoback}" Fill="{DynamicResource IconInk}" Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                        <Separator />
                        <Button Width="22" Height="22" Padding="3" Command="{x:Static vb:ApplicationCommands.AlignLeftsCommand}" ToolTip.Tip="{DynamicResource Str.Toolbar.Tip.AlignLefts}" AutomationProperties.AutomationId="FormEditor.AlignLefts">
                            <Path Data="{StaticResource Geo.Left}" Fill="{DynamicResource IconInk}" Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                        <Button Width="22" Height="22" Padding="3" Command="{x:Static vb:ApplicationCommands.AlignCentersHCommand}" ToolTip.Tip="{DynamicResource Str.Toolbar.Tip.AlignCentersHorizontally}" AutomationProperties.AutomationId="FormEditor.AlignCentersH">
                            <Path Data="{StaticResource Geo.Centerhorizontally}" Fill="{DynamicResource IconInk}" Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                        <Button Width="22" Height="22" Padding="3" Command="{x:Static vb:ApplicationCommands.AlignRightsCommand}" ToolTip.Tip="{DynamicResource Str.Toolbar.Tip.AlignRights}" AutomationProperties.AutomationId="FormEditor.AlignRights">
                            <Path Data="{StaticResource Geo.Right}" Fill="{DynamicResource IconInk}" Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                        <Separator />
                        <Button Width="22" Height="22" Padding="3" Command="{x:Static vb:ApplicationCommands.AlignTopsCommand}" ToolTip.Tip="{DynamicResource Str.Toolbar.Tip.AlignTops}" AutomationProperties.AutomationId="FormEditor.AlignTops">
                            <Path Data="{StaticResource Geo.Up}" Fill="{DynamicResource IconInk}" Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                        <Button Width="22" Height="22" Padding="3" Command="{x:Static vb:ApplicationCommands.AlignCentersVCommand}" ToolTip.Tip="{DynamicResource Str.Toolbar.Tip.AlignCentersVertically}" AutomationProperties.AutomationId="FormEditor.AlignCentersV">
                            <Path Data="{StaticResource Geo.Centervertically}" Fill="{DynamicResource IconInk}" Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                        <Button Width="22" Height="22" Padding="3" Command="{x:Static vb:ApplicationCommands.AlignBottomsCommand}" ToolTip.Tip="{DynamicResource Str.Toolbar.Tip.AlignBottoms}" AutomationProperties.AutomationId="FormEditor.AlignBottoms">
                            <Path Data="{StaticResource Geo.Bottom}" Fill="{DynamicResource IconInk}" Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                        <Separator />
                        <Button Width="22" Height="22" Padding="3" Command="{x:Static vb:ApplicationCommands.MakeSameWidthCommand}" ToolTip.Tip="{DynamicResource Str.Toolbar.Tip.MakeSameWidth}" AutomationProperties.AutomationId="FormEditor.MakeSameWidth">
                            <Path Data="{StaticResource Geo.Size}" Fill="{DynamicResource IconInk}" Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                        <Button Width="22" Height="22" Padding="3" Command="{x:Static vb:ApplicationCommands.MakeSameHeightCommand}" ToolTip.Tip="{DynamicResource Str.Toolbar.Tip.MakeSameHeight}" AutomationProperties.AutomationId="FormEditor.MakeSameHeight">
                            <Path Data="{StaticResource Geo.Size}" Fill="{DynamicResource IconInk}" Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                        <Button Width="22" Height="22" Padding="3" Command="{x:Static vb:ApplicationCommands.MakeSameSizeCommand}" ToolTip.Tip="{DynamicResource Str.Toolbar.Tip.MakeSameSize}" AutomationProperties.AutomationId="FormEditor.MakeSameSize">
                            <Path Data="{StaticResource Geo.Size}" Fill="{DynamicResource IconInk}" Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                        <Separator />
                        <ToggleButton Width="22" Height="22" Padding="3" ToolTip.Tip="{DynamicResource Str.Toolbar.Tip.LockControls}"
                                     AutomationProperties.AutomationId="FormEditor.LockControls"
                                     Command="{x:Static vb:ApplicationCommands.LockControlsCommand}"
                                     IsChecked="{CompiledBinding FocusedProjectUtil.FocusedForm?.LockControls, Mode=OneWay, TargetNullValue={x:False}}">
                            <Path Data="{StaticResource Geo.Lockcontrols}" Fill="{DynamicResource IconInk}" Width="16" Height="16" Stretch="Uniform" />
                        </ToggleButton>
                    </StackPanel>
                </ClassicBorderDecorator>
            </StackPanel>

            <!-- Status bar (Win98-style sunken panels) -->
            <ClassicBorderDecorator DockPanel.Dock="Bottom" BorderStyle="Raised" BorderThickness="1"
                                    Background="{DynamicResource {x:Static commonControls:SystemColors.ControlBrushKey}}"
                                    Height="22"
                                    AutomationProperties.AutomationId="StatusBar">
                <DockPanel x:Name="StatusBarPanel" Margin="2,1">
                    <!-- INS/OVR panel (rightmost) -->
                    <ClassicBorderDecorator DockPanel.Dock="Right" BorderStyle="Sunken" BorderThickness="1"
                                            MinWidth="50" Margin="1,0,0,0">
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4,0"
                                   FontSize="11"
                                   Foreground="{DynamicResource {x:Static commonControls:SystemColors.WindowTextBrushKey}}">
                            <TextBlock.Text>
                                <MultiBinding Converter="{x:Static utils:StatusBarConverters.InsertModeConverter}">
                                    <Binding Path="StatusBar.InsertMode" />
                                    <DynamicResource ResourceKey="Str.StatusBar.Insert" />
                                    <DynamicResource ResourceKey="Str.StatusBar.Overtype" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </ClassicBorderDecorator>
                    <!-- Ln / Col panel -->
                    <ClassicBorderDecorator DockPanel.Dock="Right" BorderStyle="Sunken" BorderThickness="1"
                                            MinWidth="120" Margin="1,0,0,0">
                        <TextBlock VerticalAlignment="Center" Margin="4,0"
                                   FontSize="11"
                                   Foreground="{DynamicResource {x:Static commonControls:SystemColors.WindowTextBrushKey}}">
                            <TextBlock.Text>
                                <MultiBinding Converter="{x:Static utils:StatusBarConverters.LinColConverter}">
                                    <Binding Path="StatusBar.Line" />
                                    <Binding Path="StatusBar.Column" />
                                    <DynamicResource ResourceKey="Str.StatusBar.LineColumn" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </ClassicBorderDecorator>
                    <!-- Message panel (fills remaining space) -->
                    <ClassicBorderDecorator BorderStyle="Sunken" BorderThickness="1"
                                            Margin="0,0,1,0">
                        <TextBlock Text="{CompiledBinding StatusBar.Message}"
                                   VerticalAlignment="Center" Margin="4,0"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource {x:Static commonControls:SystemColors.WindowTextBrushKey}}" />
                    </ClassicBorderDecorator>
                </DockPanel>
            </ClassicBorderDecorator>

            <DockControl x:Name="DockControl" Layout="{Binding Layout}">
                <DockControl.Styles>
                    <!-- Dock's theme traverses Layout before it is bound at startup. -->
                    <Style Selector="DockControl" x:DataType="DockControl">
                        <Setter Property="AutomationProperties.AutomationId" Value="{CompiledBinding $self.Layout?.Id}" />
                        <Setter Property="AutomationProperties.Name" Value="{CompiledBinding $self.Layout?.Title}" />
                        <Setter Property="dockSettings:DockProperties.IsDragEnabled" Value="{CompiledBinding $self.Layout?.CanDrag, TargetNullValue={x:True}}" />
                        <Setter Property="dockSettings:DockProperties.IsDropEnabled" Value="{CompiledBinding $self.Layout?.CanDrop, TargetNullValue={x:True}}" />
                        <Setter Property="dockSettings:DockProperties.DockGroup" Value="{CompiledBinding $self.Layout?.DockGroup}" />
                    </Style>
                    <Style Selector="ToolChromeControl /template/ Button#PART_MenuButton">
                        <Setter Property="IsVisible" Value="False" />
                    </Style>
                </DockControl.Styles>
            </DockControl>
        </DockPanel>

        <controls:MDIHostPanel Name="PART_ModalHost" IsVisible="{Binding #PART_ModalHost.Children.Count}">
            <Panel.Background>
                <VisualBrush TileMode="Tile" SourceRect="0,0,2,2" DestinationRect="0,0,2,2">
                    <VisualBrush.Visual>
                        <Canvas Width="2" Height="2" Background="Transparent">
                            <Rectangle Fill="{StaticResource {x:Static commonControls:SystemColors.ControlLightLightBrushKey}}" Width="1" Height="1" />
                            <Rectangle Fill="{StaticResource {x:Static commonControls:SystemColors.ControlLightLightBrushKey}}" Width="1" Height="1" Canvas.Left="1" Canvas.Top="1" />
                        </Canvas>
                    </VisualBrush.Visual>
                </VisualBrush>
            </Panel.Background>
        </controls:MDIHostPanel>
    </Panel>
</UserControl>
