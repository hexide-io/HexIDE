<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>$(DotNetVersion)</TargetFrameworks>
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <OutputType>Exe</OutputType>
        <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
        <!-- Without this a failing run prints a COUNT and a path to a .log nobody has: CI cannot
             say which test failed, which cost a hunt the first time it happened. With it, the name,
             the assertion message, the file and line, and the stack all reach the console. -->
        <TestingPlatformShowTestsFailure>true</TestingPlatformShowTestsFailure>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Headless.XUnit" />
        <PackageReference Include="Avalonia.Skia" />
        <PackageReference Include="AwesomeAssertions" />
        <PackageReference Include="Microsoft.Testing.Extensions.HangDump" />
        <PackageReference Include="NSubstitute" />
        <PackageReference Include="xunit.v3" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="AwesomeAssertions" />
        <Using Include="NSubstitute" />
        <Using Include="Xunit" />
        <Using Include="Avalonia.Headless.XUnit" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\HexIDE.AIChat\HexIDE.AIChat.csproj" />
        <ProjectReference Include="..\HexIDE.Desktop\HexIDE.Desktop.csproj" />
        <ProjectReference Include="..\HexIDE.Core\HexIDE.Core.csproj" />
        <ProjectReference Include="..\HexIDE\HexIDE.csproj" />
        <ProjectReference Include="..\HexIDE.Runtime\HexIDE.Runtime.csproj" />
        <!-- The fixture debug adapter, to drive the Call Stack of an external session through the real views (#1182). -->
        <ProjectReference Include="..\HexIDE.Dap.TestAdapter\HexIDE.Dap.TestAdapter.csproj" />
    </ItemGroup>

</Project>
