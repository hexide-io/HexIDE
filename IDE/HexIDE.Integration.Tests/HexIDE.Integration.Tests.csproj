<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>$(DotNetVersion)</TargetFrameworks>
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Headless.XUnit" />
        <PackageReference Include="Avalonia.Skia" />
        <PackageReference Include="AwesomeAssertions" />
        <PackageReference Include="Microsoft.Testing.Extensions.HangDump" />
        <PackageReference Include="NSubstitute" />
        <PackageReference Include="xunit.v3.mtp-v2" />
        <PackageReference Include="Microsoft.Testing.Extensions.Telemetry" />
        <PackageReference Include="Microsoft.Testing.Extensions.TrxReport.Abstractions" />
        <PackageReference Include="Microsoft.Testing.Platform" />
        <PackageReference Include="Microsoft.Testing.Platform.MSBuild" />
        <!-- ProviderTestSortTests binds this project's sources to sort them for #3411 (#3663). -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    </ItemGroup>
    <ItemGroup>
        <Compile Include="..\HexIDE.Tests\Infrastructure\ProviderTestSort.cs" Link="Infrastructure\ProviderTestSort.cs" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="AwesomeAssertions" />
        <Using Include="NSubstitute" />
        <Using Include="Xunit" />
        <Using Include="Avalonia.Headless.XUnit" />
        <Using Include="HexIDE.Projects" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\HexIDE.AIChat\HexIDE.AIChat.csproj" />
        <ProjectReference Include="..\HexIDE.Desktop\HexIDE.Desktop.csproj" />
        <ProjectReference Include="..\HexIDE.Core\HexIDE.Core.csproj" />
        <ProjectReference Include="..\HexIDE\HexIDE.csproj" />
        <ProjectReference Include="..\HexIDE.Runtime\HexIDE.Runtime.csproj" />
        <ProjectReference Include="..\HexIDE.Standalone\HexIDE.Standalone.csproj" />
        <!-- The fixture debug adapter, to drive the Call Stack of an external session through the real views (#1182). -->
        <ProjectReference Include="..\HexIDE.Dap.TestAdapter\HexIDE.Dap.TestAdapter.csproj" />
    </ItemGroup>

  <ItemGroup>
    <!-- One cleanup per test class: xunit v3 never calls Dispose beside DisposeAsync (#3411 slice 10b-3). -->
    <Compile Include="..\HexIDE.Tests\Infrastructure\TestClassCleanupTests.cs" Link="Infrastructure\TestClassCleanupTests.cs" />
  </ItemGroup>
</Project>
