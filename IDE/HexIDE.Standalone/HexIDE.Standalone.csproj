<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFrameworks>$(DotNetVersion)</TargetFrameworks>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <WarningsAsErrors>nullable</WarningsAsErrors>
        <!--
            AOT is off: ILCompiler crashes generating code for a LanguageExt generic instantiation
            reached through HexIDE.Runtime (CodeGenerationFailedException wrapping an
            IndexOutOfRangeException in LazyGenericsSupport). That is a compiler defect, not a
            missing native toolchain, so it fails on every RID.

            SelfContained is deliberately NOT set here. This runner ships inside both release
            packages, and each needs a different answer, so the release workflow publishes the
            project twice and passes the flag explicitly. A local publish without the flag is
            framework dependent, which is what a dev machine wants.
        -->
        <PublishAot>false</PublishAot>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <DebugSymbols>False</DebugSymbols>
        <DebugType>None</DebugType>
        <ApplicationIcon>form.ico</ApplicationIcon>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <NoWarn>$(NoWarn);CS1998</NoWarn>
        <WarningsNotAsErrors>IL2026;IL3053;IL2104;</WarningsNotAsErrors>
    </PropertyGroup>

    <PropertyGroup>
        <ApplicationManifest>app.manifest</ApplicationManifest>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" />
        <PackageReference Include="Avalonia.Themes.Simple" />
        <PackageReference Include="Avalonia.Diagnostics" />
        <PackageReference Include="Avalonia.Desktop" />
        <PackageReference Include="Classic.Avalonia.Theme" />
        <PackageReference Include="PropertyChanged.SourceGenerator" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\HexIDE.Runtime\HexIDE.Runtime.csproj" />
    </ItemGroup>

    <ItemGroup>
        <AvaloniaResource Include="Resources\**\*" />
        <None Remove="form.ico" />
        <AvaloniaResource Include="form.ico" />
    </ItemGroup>
</Project>
