<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFrameworks>$(DotNetVersion)</TargetFrameworks>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <WarningsAsErrors>nullable</WarningsAsErrors>
        <!--
            AOT is off: ILCompiler crashes generating code for a LanguageExt generic instantiation
            reached through HexIDE.Runtime (CodeGenerationFailedException wrapping an
            IndexOutOfRangeException in LazyGenericsSupport). That is a compiler defect, not a
            missing native toolchain, so it fails on every RID.

            A made program is this runner, renamed, beside its project archive, and Make copies that
            one file (#1971). So a publish is one self-contained single file, with the native
            libraries inside it, in both release packages and on a dev machine alike. A publish
            with no runtime identifier takes the SDK's own. Building is unaffected.
        -->
        <PublishAot>false</PublishAot>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <DebugSymbols>False</DebugSymbols>
        <DebugType>None</DebugType>
        <ApplicationIcon>form.ico</ApplicationIcon>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <NoWarn>$(NoWarn);CS1998</NoWarn>
        <WarningsNotAsErrors>IL2026;IL3053;IL2104;</WarningsNotAsErrors>
    </PropertyGroup>

    <PropertyGroup>
        <ApplicationManifest>app.manifest</ApplicationManifest>
    </PropertyGroup>

    <!-- _IsPublishing is set by dotnet publish for its restore and build too, so the three agree on the runtime. -->
    <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
        <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkPortableRuntimeIdentifier)</RuntimeIdentifier>
        <SelfContained>true</SelfContained>
        <PublishSingleFile>true</PublishSingleFile>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" />
        <PackageReference Include="Avalonia.Themes.Simple" />
        <PackageReference Include="Avalonia.Desktop" />
        <PackageReference Include="Classic.Avalonia.Theme" />
        <PackageReference Include="PropertyChanged.SourceGenerator" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\HexIDE.Runtime\HexIDE.Runtime.csproj" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="..\HexIDE\Localization\Packs\en.json" LogicalName="HexIDE.Standalone.ErrorStrings.json" />
        <AvaloniaResource Include="Resources\**\*" />
        <None Remove="form.ico" />
        <AvaloniaResource Include="form.ico" />
    </ItemGroup>
</Project>
