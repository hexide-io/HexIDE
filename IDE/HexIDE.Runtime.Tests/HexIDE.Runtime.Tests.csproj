<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- LibraryImport-generated marshalling for the independent NLS date oracle. -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <TargetFrameworks>$(DotNetVersion)</TargetFrameworks>
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <IsPackable>false</IsPackable>
        <OutputType>Exe</OutputType>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="AwesomeAssertions" />
        <PackageReference Include="NSubstitute" />
        <PackageReference Include="xunit.v3.mtp-v2" />
        <PackageReference Include="Microsoft.Testing.Extensions.Telemetry" />
        <PackageReference Include="Microsoft.Testing.Extensions.TrxReport.Abstractions" />
        <PackageReference Include="Microsoft.Testing.Platform" />
        <PackageReference Include="Microsoft.Testing.Platform.MSBuild" />
        <PackageReference Include="xunit.analyzers" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="AwesomeAssertions" />
        <Using Include="NSubstitute" />
        <Using Include="Xunit" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\HexIDE.Core\HexIDE.Core.csproj" />
        <ProjectReference Include="..\HexIDE.Runtime\HexIDE.Runtime.csproj" />
    </ItemGroup>

    <!-- Redirect before any test can read or write the contributor's IDE profile (#3805). -->
    <ItemGroup>
        <Compile Include="..\HexIDE.Integration.Tests\TemporaryProfile.cs" Link="Infrastructure\TemporaryProfile.cs" />
        <Compile Include="..\HexIDE.Integration.Tests\TemporaryProfileTests.cs" Link="Infrastructure\TemporaryProfileTests.cs" />
    </ItemGroup>

    <!-- The runner's load, for what DebuggerSignalGuard says when a debugger signal runs out (#4433). -->
    <ItemGroup>
        <Compile Include="..\HexIDE.Tests\Infrastructure\RunnerLoad.cs" Link="Infrastructure\RunnerLoad.cs" />
    </ItemGroup>

    <!-- Share project and document factories with the IDE tests. -->
    <ItemGroup>
        <Compile Include="..\HexIDE.Tests\TestHelpers.cs" Link="Infrastructure\TestHelpers.cs" />
    </ItemGroup>

  <ItemGroup>
    <!-- One cleanup per test class: xunit v3 never calls Dispose beside DisposeAsync (#3411 slice 10b-3). -->
    <Compile Include="..\HexIDE.Tests\Infrastructure\TestClassCleanupTests.cs" Link="Infrastructure\TestClassCleanupTests.cs" />
    <Compile Include="..\HexIDE.Tests\Infrastructure\ResolvedTemp.cs" Link="Infrastructure\ResolvedTemp.cs" />
  </ItemGroup>
</Project>
