<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Build-time / SDK tool that produces SIGNED add-in packages. It is NOT shipped in the IDE — the
    IDE only ever *verifies* (see HexIDE.Core/Addins/PackageCrypto + PackageVerifier). The Desktop
    build references this project to package the first-party add-ins; HexIDE.Tests references it to
    exercise the verifier against freshly-signed fixtures.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- No PackageReference here, ever: the release's signing job runs this program next to the first-party key, so
       every package it builds with is code trusted with that key. hexide-pack (HexIDE.AddinPacker.Interactive) holds
       the prompts and their package, and calls PackerCli.Run (#5555, PackerFrontEndBoundaryTests). -->
  <ItemGroup>
    <ProjectReference Include="..\HexIDE.Core\HexIDE.Core.csproj" />
  </ItemGroup>

</Project>
