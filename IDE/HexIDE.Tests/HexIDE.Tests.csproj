<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>$(DotNetVersion)</TargetFrameworks>
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <IsPackable>false</IsPackable>
        <OutputType>Exe</OutputType>
        <IsTestProject>true</IsTestProject>
        <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
        <!-- Without this a failing run prints a COUNT and a path to a .log nobody has: CI cannot
             say which test failed, which cost a hunt the first time it happened. With it, the name,
             the assertion message, the file and line, and the stack all reach the console. -->
        <TestingPlatformShowTestsFailure>true</TestingPlatformShowTestsFailure>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Headless" />
        <PackageReference Include="Avalonia.Headless.XUnit" />
        <PackageReference Include="AwesomeAssertions" />
        <PackageReference Include="NSubstitute" />
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="xunit.analyzers" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    </ItemGroup>

    <ItemGroup>
        <AvaloniaResource Include="Localization\Packs\*.json" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="AwesomeAssertions" />
        <Using Include="NSubstitute" />
        <Using Include="Xunit" />
        <Using Include="Avalonia.Headless.XUnit" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\HexIDE.Dap\HexIDE.Dap.csproj" />
        <ProjectReference Include="..\HexIDE.Dap.TestAdapter\HexIDE.Dap.TestAdapter.csproj" />
        <!-- Build-check the opt-in real adapter tools on CI without executing or bundling an external backend. -->
        <ProjectReference Include="..\HexIDE.Dap.Smoke\HexIDE.Dap.Smoke.csproj" ReferenceOutputAssembly="false" />
        <ProjectReference Include="..\HexIDE.Dap.Parity\HexIDE.Dap.Parity.csproj" />
        <ProjectReference Include="..\HexIDE\HexIDE.csproj" />
        <ProjectReference Include="..\HexIDE.Standalone\HexIDE.Standalone.csproj" />
        <ProjectReference Include="..\HexIDE.Runtime\HexIDE.Runtime.csproj" />
        <ProjectReference Include="..\HexIDE.AIChat\HexIDE.AIChat.csproj" />
        <!-- PackageSigner is used to produce signed fixtures for the verifier tests. -->
        <ProjectReference Include="..\HexIDE.AddinPacker\HexIDE.AddinPacker.csproj" />
    </ItemGroup>

    <!-- Exercise the actual Debug automation server, including its generated native stubs.
         Keep unsafe compilation confined to the three production interop projects. -->
    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
        <PackageReference Include="ModelContextProtocol.AspNetCore" />
        <ProjectReference Include="../HexIDE.Desktop/HexIDE.Desktop.csproj" SetConfiguration="Configuration=Debug" />
        <!-- The SDK compiler parses the unsafe-code guard; no extra package is needed. -->
        <Reference Include="Microsoft.CodeAnalysis" HintPath="$(MSBuildToolsPath)/Roslyn/bincore/Microsoft.CodeAnalysis.dll" />
        <Reference Include="Microsoft.CodeAnalysis.CSharp" HintPath="$(MSBuildToolsPath)/Roslyn/bincore/Microsoft.CodeAnalysis.CSharp.dll" />
    </ItemGroup>

    <!-- VB6's Template tree is found one way in both test projects: the folder or the one above it, a set variable
         that finds nothing failing rather than skipping (#1440). -->
    <ItemGroup>
        <Compile Include="..\HexIDE.Runtime.Tests\Vb6Template.cs" Link="Infrastructure\Vb6Template.cs" />
    </ItemGroup>

</Project>
