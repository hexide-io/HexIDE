<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>$(DotNetVersion)</TargetFrameworks>
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <IsPackable>false</IsPackable>
        <OutputType>Exe</OutputType>
        <IsTestProject>true</IsTestProject>
        <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
        <!-- Without this a failing run prints a COUNT and a path to a .log nobody has: CI cannot
             say which test failed, which cost a hunt the first time it happened. With it, the name,
             the assertion message, the file and line, and the stack all reach the console. -->
        <TestingPlatformShowTestsFailure>true</TestingPlatformShowTestsFailure>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Headless" />
        <PackageReference Include="Avalonia.Headless.XUnit" />
        <PackageReference Include="AwesomeAssertions" />
        <PackageReference Include="NSubstitute" />
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="xunit.analyzers" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="AwesomeAssertions" />
        <Using Include="NSubstitute" />
        <Using Include="Xunit" />
        <Using Include="Avalonia.Headless.XUnit" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\HexIDE.Dap\HexIDE.Dap.csproj" />
        <ProjectReference Include="..\HexIDE.Dap.TestAdapter\HexIDE.Dap.TestAdapter.csproj" />
        <!-- Build-check the opt-in real adapter tools on CI without executing or bundling an external backend. -->
        <ProjectReference Include="..\HexIDE.Dap.Smoke\HexIDE.Dap.Smoke.csproj" ReferenceOutputAssembly="false" />
        <ProjectReference Include="..\HexIDE.Dap.Parity\HexIDE.Dap.Parity.csproj" ReferenceOutputAssembly="false" />
        <ProjectReference Include="..\HexIDE\HexIDE.csproj" />
        <ProjectReference Include="..\HexIDE.Runtime\HexIDE.Runtime.csproj" />
        <ProjectReference Include="..\HexIDE.AIChat\HexIDE.AIChat.csproj" />
        <!-- PackageSigner is used to produce signed fixtures for the verifier tests. -->
        <ProjectReference Include="..\HexIDE.AddinPacker\HexIDE.AddinPacker.csproj" />
    </ItemGroup>

    <!-- The automation server's tools and transport: direct tool calls (FormControlsSummaryTests)
         and a real server restarted under the SDK's own client (McpRestartTests). No test project
         references HexIDE.Desktop, so these production files are compiled in here as well; the server
         and the test cannot then disagree about them. -->
    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
        <PackageReference Include="ModelContextProtocol.AspNetCore" />
        <Compile Include="..\HexIDE.Desktop\ServerOptions.cs" Link="Infrastructure\ServerOptions.cs" />
        <Compile Include="..\HexIDE.Desktop\ConsoleOutput.cs" Link="Infrastructure\ConsoleOutput.cs" />
        <Compile Include="..\HexIDE.Desktop\HelpMark.cs" Link="Infrastructure\HelpMark.cs" />
        <Compile Include="..\HexIDE.Desktop\Server\HexIdeTools.cs" Link="Infrastructure\HexIdeTools.cs" />
        <Compile Include="..\HexIDE.Desktop\Server\IdeContext.cs" Link="Infrastructure\IdeContext.cs" />
        <Compile Include="..\HexIDE.Desktop\Server\DiagnosticsCache.cs" Link="Infrastructure\DiagnosticsCache.cs" />
        <Compile Include="..\HexIDE.Desktop\Server\DescribesEnumAttribute.cs" Link="Infrastructure\DescribesEnumAttribute.cs" />
        <Compile Include="..\HexIDE.Desktop\Server\LoopbackMiddleware.cs" Link="Infrastructure\LoopbackMiddleware.cs" />
        <Compile Include="..\HexIDE.Desktop\Server\McpTransport.cs" Link="Infrastructure\McpTransport.cs" />
        <Compile Include="..\HexIDE.Desktop\Server\ToolFailures.cs" Link="Infrastructure\ToolFailures.cs" />
        <Compile Include="..\HexIDE.Desktop\Server\SessionGuard.cs" Link="Infrastructure\SessionGuard.cs" />
        <Compile Include="..\HexIDE.Desktop\Server\ToolFilters.cs" Link="Infrastructure\ToolFilters.cs" />
        <Compile Include="..\HexIDE.Desktop\Server\ArgumentCheck.cs" Link="Infrastructure\ArgumentCheck.cs" />
        <Compile Include="..\HexIDE.Desktop\Server\OpenDialogNote.cs" Link="Infrastructure\OpenDialogNote.cs" />
        <Compile Include="..\HexIDE.Desktop\Server\ReplyJson.cs" Link="Infrastructure\ReplyJson.cs" />
        <Compile Include="..\HexIDE.Desktop\Server\InlineSnapshot.cs" Link="Infrastructure\InlineSnapshot.cs" />
        <Compile Include="..\HexIDE.Desktop\Server\MenuCommandRefusal.cs" Link="Infrastructure\MenuCommandRefusal.cs" />
    </ItemGroup>

    <!-- VB6's Template tree is found one way in both test projects: the folder or the one above it, a set variable
         that finds nothing failing rather than skipping (#1440). -->
    <ItemGroup>
        <Compile Include="..\HexIDE.Runtime.Tests\Vb6Template.cs" Link="Infrastructure\Vb6Template.cs" />
    </ItemGroup>

</Project>
