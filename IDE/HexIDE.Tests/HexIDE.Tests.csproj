<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>$(DotNetVersion)</TargetFrameworks>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <!-- xUnit1051 asks that every call taking a CancellationToken be given
             TestContext.Current.CancellationToken, so a test reacts to the runner cancelling it. It fires
             366 times here, all of it pre-existing code that xunit v3 can see and v2 could not.
             Suppressed rather than swept through in the migration commit: passing a live token where
             `default` was passed CHANGES BEHAVIOUR under cancellation, so 366 of them is a change to make
             deliberately and verify, not a mechanical find-and-replace ridden along with a package bump.
             Tracked in hexide-io/HexIDE#300. Remove this line when that is done. -->
        <NoWarn>$(NoWarn);xUnit1051</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Headless" />
        <PackageReference Include="AwesomeAssertions" />
        <PackageReference Include="coverlet.collector" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="NSubstitute" />
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="xunit.analyzers" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
        <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="AwesomeAssertions" />
        <Using Include="NSubstitute" />
        <Using Include="Xunit" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\HexIDE\HexIDE.csproj" />
        <ProjectReference Include="..\HexIDE.Runtime\HexIDE.Runtime.csproj" />
        <ProjectReference Include="..\HexIDE.AIChat\HexIDE.AIChat.csproj" />
        <!-- PackageSigner is used to produce signed fixtures for the verifier tests. -->
        <ProjectReference Include="..\HexIDE.AddinPacker\HexIDE.AddinPacker.csproj" />
    </ItemGroup>

</Project>
