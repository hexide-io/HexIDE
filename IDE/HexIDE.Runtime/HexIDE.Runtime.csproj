<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>$(DotNetVersion)</TargetFrameworks>
        <Nullable>enable</Nullable>
        <!-- LibraryImport-generated marshalling only; NativeInteropTests guards handwritten code. -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <LangVersion>latest</LangVersion>
        <WarningsAsErrors>nullable</WarningsAsErrors>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <TrimMode>full</TrimMode>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <NoWarn>$(NoWarn);CS1998</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" />
        <PackageReference Include="Classic.Avalonia.Theme" />
        <PackageReference Include="LanguageExt.Core" />
        <PackageReference Include="Serilog" />
        <PackageReference Include="PropertyChanged.SourceGenerator" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
        <PackageReference Include="Antlr4.Runtime.Standard" />
        <PackageReference Include="Antlr4BuildTasks" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\HexIDE.Core\HexIDE.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="HexIDE.Runtime.Tests" />
        <InternalsVisibleTo Include="HexIDE.Tests" />
        <InternalsVisibleTo Include="HexIDE.Integration.Tests" />
    </ItemGroup>

    <ItemGroup>
        <!-- VB6's in-box constants, read out of the real type libraries by
             scripts/dump-typelib-constants.ps1 and catalogued in docs/vb6-inbox-constants.md.
             Embedded rather than code-generated so the measured data stays the single source of
             truth with no generated file to drift from it, and rather than read from disk so it
             cannot go missing from a published build. -->
        <EmbeddedResource Include="Interpreter\Data\vb6-inbox-constants.json" />
        <EmbeddedResource Include="Interpreter\Data\comdlg32-constants.json" />
        <EmbeddedResource Include="Interpreter\Data\mscomctl-constants.json" />
        <EmbeddedResource Include="Interpreter\Data\comctl32-constants.json" />
        <EmbeddedResource Include="Interpreter\Data\tabdlg-constants.json" />
        <EmbeddedResource Include="Interpreter\Data\msmask32-constants.json" />
        <!-- The types those libraries declare, read by scripts/dump-typelib-types.ps1, and embedded for the same
             reasons: which names after `As` are VB's own object types (#822). -->
        <EmbeddedResource Include="Interpreter\Data\vb6-inbox-types.json" />
        <!-- The members of VB6's Form class, read out of VB6.OLB by scripts/dump-typelib-members.ps1, and
             embedded for the same reasons: which bare names in a form are the form's own (#995). -->
        <EmbeddedResource Include="Interpreter\Data\vb6-form-members.json" />

    </ItemGroup>

    <ItemGroup>
        <Antlr4 Include="Interpreter\Grammar\VB6.g4">
            <CustomToolNamespace>HexIDE.Runtime.Interpreter.Grammar</CustomToolNamespace>
            <Listener>True</Listener>
            <Visitor>True</Visitor>
            <Log>True</Log>
            <LongMessages />
        </Antlr4>
    </ItemGroup>
</Project>
