<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:HexIDE.Runtime.Dialogs"
             x:DataType="local:ColorDialog"
             x:Class="HexIDE.Runtime.Dialogs.ColorDialog">
    <StackPanel Margin="12" Spacing="8" MinWidth="280">
        <WrapPanel x:Name="PART_Palette" />
        <TextBlock Text="{DynamicResource Str.Dialog.Color.Rgb}" />
        <TextBox x:Name="PART_Rgb" MaxLength="6" />
        <Border x:Name="PART_Preview" Height="40" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="PART_Ok" Content="{DynamicResource Str.Dialog.MessageBox.Button.Ok}" IsDefault="True" Click="OkClick" />
            <Button x:Name="PART_Cancel" Content="{DynamicResource Str.Dialog.MessageBox.Button.Cancel}" IsCancel="True" Click="CancelClick" />
        </StackPanel>
    </StackPanel>
</UserControl>
