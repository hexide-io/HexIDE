<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:builtinControls="clr-namespace:HexIDE.Runtime.BuiltinControls"
                    xmlns:common="clr-namespace:Classic.CommonControls;assembly=Classic.CommonControls.Avalonia">
    <ControlTheme x:Key="{x:Type builtinControls:VBCheckBox}"
                  TargetType="builtinControls:VBCheckBox"
                  BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="Template">
            <ControlTemplate>
                <!-- copy paste from Classic.Avalonia, with changed background template binding -->
                <BulletDecorator Background="{TemplateBinding Background}">
                    <BulletDecorator.Bullet>
                        <!-- Draw Checkmark border and tick mark -->
                        <!-- Width/Height pin the glyph to VB6's 13x13 check box. Without them the
                             decorator is measured from its child, so hiding the tick (rules below)
                             collapses the box to the border alone. It also removes an existing
                             inconsistency: the 3D variant measured 11x11 while FlatVBCheckBox's 2px
                             border pushed it to 13x13. -->
                        <ClassicBorderDecorator x:Name="CheckMark"
                                                Width="13"
                                                Height="13"
                                                BorderStyle="Sunken"
                                                Background="{DynamicResource {x:Static common:SystemColors.WindowBrushKey}}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                BorderBrush="{TemplateBinding BorderBrush}">
                            <Path x:Name="CheckMarkPath"
                                  Margin="1,1,1,1"
                                  Width="7"
                                  Height="7"
                                  FlowDirection="LeftToRight"
                                  Fill="{TemplateBinding Foreground}"
                                  Data="M 0 2.0 L 0 4.8 L 2.5 7.4 L 7.1 2.8 L 7.1 0 L 2.5 4.6 Z" />
                        </ClassicBorderDecorator>
                    </BulletDecorator.Bullet>
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      IsVisible="{TemplateBinding Content,
                                                                Converter={x:Static ObjectConverters.IsNotNull}}"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      TextElement.Foreground="{TemplateBinding Foreground}"
                                      RecognizesAccessKey="True" />
                </BulletDecorator>
            </ControlTemplate>
        </Setter>
        <!-- Tick visibility. The base CheckBox theme (SimpleTheme) drives a part it calls
             Path#checkMark; this template names its tick CheckMarkPath, so those rules never matched
             and the tick was painted in EVERY state — an unchecked box rendered ticked. Restated here
             against the real part name. -->
        <Style Selector="^ /template/ Path#CheckMarkPath">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:checked /template/ Path#CheckMarkPath">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <!-- VB6 Value = 2 (Greyed) arrives as IsChecked = null: tick shown, in the grey text colour. -->
        <Style Selector="^:indeterminate /template/ Path#CheckMarkPath">
            <Setter Property="IsVisible" Value="True" />
            <Setter Property="Fill" Value="{DynamicResource {x:Static common:SystemColors.GrayTextBrushKey}}" />
        </Style>
    </ControlTheme>
    <ControlTheme x:Key="FlatVBCheckBox"
                  TargetType="builtinControls:VBCheckBox"
                  BasedOn="{StaticResource {x:Type builtinControls:VBCheckBox}}">
        <Setter Property="BorderBrush" Value="Black" />
        <Setter Property="BorderThickness" Value="2" />
    </ControlTheme>



    <ControlTheme x:Key="{x:Type builtinControls:VBOptionButton}"
                  TargetType="builtinControls:VBOptionButton"
                  BasedOn="{StaticResource {x:Type RadioButton}}">
        <Setter Property="Template">
            <ControlTemplate>
                <!-- copy paste from Classic.Avalonia, with changed background template binding -->
                <BulletDecorator Background="{TemplateBinding Background}">
                    <BulletDecorator.Bullet>
                        <!-- Draw Checkmark border and tick mark -->
                        <ClassicBorderDecorator x:Name="Border"
                                                        Width="13"
                                                        Height="13"
                                                        BorderStyle="RadioButton"
                                                        Background="{DynamicResource {x:Static common:SystemColors.WindowBrushKey}}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}">
                            <Ellipse x:Name="checkMark"
                                     Fill="{TemplateBinding Foreground}"
                                     Width="4"
                                     Height="4"/>
                        </ClassicBorderDecorator>
                    </BulletDecorator.Bullet>
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Margin="{TemplateBinding Padding}"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      RecognizesAccessKey="True"/>
                </BulletDecorator>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
    <ControlTheme x:Key="FlatVBOptionButton"
                  TargetType="builtinControls:VBOptionButton"
                  BasedOn="{StaticResource {x:Type builtinControls:VBOptionButton}}">
        <Setter Property="BorderBrush" Value="Black" />
    </ControlTheme>


    <!-- VB6's Frame is a Win32 group box: an etched rectangle whose top edge is broken by the caption.
         SimpleTheme's stock HeaderedContentControl draws no border at all, so until now a loaded Frame
         rendered as a bare floating caption with nothing around it.

         The child host is the part that matters beyond appearance. It fills the control's OUTER bounds,
         because VB6 measures a Frame's children from the control's own top-left — the stock template's
         presenter is inset by the border AND pushed below the header, which would displace every contained
         control by an amount depending on whichever theme was loaded. -->
    <ControlTheme x:Key="{x:Type builtinControls:VBFrame}"
                  TargetType="builtinControls:VBFrame">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static common:SystemColors.ControlTextBrushKey}}" />
        <Setter Property="Template">
            <ControlTemplate>
                <!-- The Panel carries the BackColor across the whole control, as VB6 does; the decorator
                     above it draws lines only. -->
                <Panel Background="{TemplateBinding Background}">
                    <!-- Top margin of 7 puts the etched edge through the middle of the caption's line,
                         which is where Win32 draws it.

                         The two 3D brushes are set explicitly for the same reason VBTimer.axaml sets them:
                         ClassicBorderDecorator's defaults come from the Classic theme, and <ClassicTheme />
                         is deliberately not loaded here — leave them unset and the decorator draws nothing
                         at all, which is exactly what the first cut of this template did. -->
                    <ClassicBorderDecorator BorderStyle="Etched"
                                            BorderThickness="2"
                                            Margin="0,7,0,0"
                                            BorderDarkBrush="{DynamicResource {x:Static common:SystemColors.ControlDarkBrushKey}}"
                                            BorderLightLightBrush="{DynamicResource {x:Static common:SystemColors.ControlLightLightBrushKey}}" />
                    <!-- The caption paints its own background over that edge. That mask is how a group box
                         breaks its border for the text; the frame's BackColor defaults to button face, so
                         there is always something to mask with. -->
                    <ContentPresenter Content="{TemplateBinding Header}"
                                      Background="{TemplateBinding Background}"
                                      Foreground="{TemplateBinding Foreground}"
                                      Padding="3,0"
                                      Margin="6,0,0,0"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Top" />
                    <ContentPresenter Content="{TemplateBinding ChildHost}" />
                </Panel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- The border is no longer hardcoded Sunken/2: it comes from VB6's BorderStyle and Appearance, so a
         PictureBox the file says is flat and borderless stops being drawn with a 3-D border around it.

         The child host sits INSIDE the decorator on purpose. The decorator insets its child by exactly the
         thickness it draws, so a contained control's origin IS the client origin by construction — the
         layout offset cannot drift from the border the user can see, which is the same number. -->
    <ControlTheme x:Key="{x:Type builtinControls:VBPictureBox}"
                  TargetType="builtinControls:VBPictureBox">
        <Setter Property="Template">
            <ControlTemplate>
                <ClassicBorderDecorator BorderStyle="{TemplateBinding ClientBorderStyle}"
                                        BorderThickness="{TemplateBinding ClientInset}"
                                        Background="{TemplateBinding Background}"
                                        BorderControlBrush="{DynamicResource {x:Static common:SystemColors.ControlBrushKey}}"
                                        BorderLightBrush="{DynamicResource {x:Static common:SystemColors.ControlLightBrushKey}}"
                                        BorderLightLightBrush="{DynamicResource {x:Static common:SystemColors.ControlLightLightBrushKey}}"
                                        BorderDarkBrush="{DynamicResource {x:Static common:SystemColors.ControlDarkBrushKey}}"
                                        BorderDarkDarkBrush="{DynamicResource {x:Static common:SystemColors.ControlDarkDarkBrushKey}}">
                    <Panel>
                        <Image Source="{TemplateBinding Picture}"
                               Stretch="None"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top" />
                        <ContentPresenter Content="{TemplateBinding ChildHost}" />
                    </Panel>
                </ClassicBorderDecorator>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

</ResourceDictionary>