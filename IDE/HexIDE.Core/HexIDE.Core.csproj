<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>$(DotNetVersion)</TargetFrameworks>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <!-- ReadableJsonEncoder: a JavaScriptEncoder overrides members that take a pointer. -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <RootNamespace>HexIDE</RootNamespace>
        <Description>Framework-agnostic abstractions for building VB6 IDEs. Zero third-party dependencies.</Description>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" IncludeAssets="analyzers;build;buildtransitive" />
        <GlobalAnalyzerConfigFiles Include="PublicAPI.globalconfig" />
    </ItemGroup>

    <!-- The host-code-page probe is compiled only in Debug; keep its API guard in that configuration. -->
    <ItemGroup Condition="'$(Configuration)' == 'Debug'">
        <AdditionalFiles Include="PublicAPI.Debug/PublicAPI.Shipped.txt" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="HexIDE.Tests" />
        <InternalsVisibleTo Include="HexIDE.Integration.Tests" />
        <InternalsVisibleTo Include="HexIDE.Runtime.Integration.Tests" />
        <!-- A project's target is first-party only until an add-in needs it: one vendor's name and a single value
             are the wrong public shape for the plural Targets key (#4821). -->
        <InternalsVisibleTo Include="HexIDE" />
        <InternalsVisibleTo Include="HexIDE.Runtime" />
        <InternalsVisibleTo Include="HexIDE.Runtime.Tests" />
    </ItemGroup>

    <ItemGroup>
        <!-- The pseudonym pool. Embedded rather than copied beside the assembly: it is read once at first
             use and a missing file would make redaction fail at the moment somebody is trying to share a
             capture, which is the worst possible moment to discover a packaging mistake. -->
        <EmbeddedResource Include="Redaction\pseudonym-pool.txt" />
    </ItemGroup>

</Project>
