<Project Sdk="Microsoft.NET.Sdk">
  <!-- A coverage-guided fuzz harness for a form's companion .frx (#1222). Not part of the product, the solution, any
       test run or CI: see README.md for how to build, instrument and run it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../IDE/HexIDE.Runtime/HexIDE.Runtime.csproj" />
    <PackageReference Include="SharpFuzz" />
    <PackageReference Include="Avalonia.Headless" />
  </ItemGroup>
</Project>
