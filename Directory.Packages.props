<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <!-- Avalonia-repository packages move together at 12.1.5, including Headless and Browser (#868).
       12.1.5 fixes pointer popup resizing after the first measure (#3809; AvaloniaUI/Avalonia#22573).
       Controls.DataGrid, AvaloniaEdit, Classic.Avalonia and Dock have separate version streams.
       Avalonia 12.1.1 relaxed typed method bindings (AvaloniaUI/Avalonia#21867), but prefers a
       single-parameter overload: keep parameterless command entry points unambiguous. -->
  <ItemGroup>
    <PackageVersion Include="Avalonia" Version="12.1.5" />
    <PackageVersion Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageVersion Include="Avalonia.Browser" Version="12.1.5" />
    <PackageVersion Include="Avalonia.Controls.ColorPicker" Version="12.1.5" />
    <PackageVersion Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <!-- NB: Avalonia.Controls.TreeDataGrid 12.x is a COMMERCIAL "Avalonia Accelerate" product (MIT only through
         11.2.x) — building against it fails with AVLIC0001 (no licence key). Deliberately NOT used; the debugger
         Locals pane uses a native Avalonia TreeView + a columnar row template instead. Do not re-add it. -->
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.5" />
    <!-- Keep the two headless packages at Avalonia's version. 12.0.2's session started each test on whatever context its
         thread was left holding, so a run could lose hundreds of tests to errors MTP does not count and still pass
         (#2486, fixed in 12.0.4 by AvaloniaUI/Avalonia#21357). HeadlessTestContextTests checks it. -->
    <PackageVersion Include="Avalonia.Headless" Version="12.1.5" />
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="12.1.5" />
    <PackageVersion Include="Avalonia.Skia" Version="12.1.5" />
    <PackageVersion Include="Avalonia.Themes.Simple" Version="12.1.5" />
    <PackageVersion Include="Avalonia.Wayland" Version="12.1.5" />
    <!-- 12.0.1-beta1 is the Avalonia-12 build. The 11.3.0.3 assembly was compiled against Avalonia 11,
         and its ClassicBorderDecorator.DrawRadioButtonBorder called
         StreamGeometryContext.ArcTo(Point, Size, double, bool, SweepDirection) — an overload Avalonia 12
         replaced — so BorderStyle="RadioButton" threw MissingMethodException on the render thread and
         took the whole process down with nothing in the managed log. Every VB6 option button hit it, in
         the designer and at runtime. Do not pin back. Classic.CommonControls.Avalonia follows
         transitively. <ClassicTheme /> is still NOT loaded and must not be. -->
    <PackageVersion Include="Classic.Avalonia.Theme" Version="12.0.1-beta1" />
  </ItemGroup>
  <!-- Dock -->
  <ItemGroup>
    <PackageVersion Include="Dock.Avalonia" Version="12.0.0.2" />
    <PackageVersion Include="Dock.Avalonia.Themes.Simple" Version="12.0.0.2" />
    <PackageVersion Include="Dock.Model" Version="12.0.0.2" />
    <PackageVersion Include="Dock.Model.Avalonia" Version="12.0.0.2" />
    <PackageVersion Include="Dock.Model.MVVM" Version="12.0.0.2" />
  </ItemGroup>
  <!-- ANTLR4 -->
  <ItemGroup>
    <PackageVersion Include="Antlr4.Runtime.Standard" Version="4.13.1" />
    <PackageVersion Include="Antlr4BuildTasks" Version="12.14.0" />
  </ItemGroup>
  <!-- Logging -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageVersion Include="Serilog" Version="4.3.0" />
    <PackageVersion Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>
  <!-- LSP / StreamJsonRpc — Nerdbank.MessagePack pinned above 1.0.2 (GHSA-2cwq-pwfr-wcw3);
       MessagePack pinned above 2.5.198 (CVE-2026-48109 / GHSA-hv8m-jj95-wg3x) and at 2.5.303 or later
       (GHSA-qhrr-8q5h-9q3h, #1124), pulled in by StreamJsonRpc. HexIDE formats with SystemTextJsonFormatter and never
       uses MessagePack itself, but NU1902 is an error here, so an advisory against the pin stops every build. -->
  <ItemGroup>
    <PackageVersion Include="MessagePack" Version="2.5.307" />
    <PackageVersion Include="Nerdbank.MessagePack" Version="1.2.4" />
    <PackageVersion Include="StreamJsonRpc" Version="2.24.92" />
  </ItemGroup>
  <!-- LSP server shell (MIT) — EmmyLua.LanguageServer.Framework: JSON-RPC + LSP plumbing for the
       MIT VB6 language server (replaces the GPLv3 hand-rolled dispatcher). net9 asset, zero deps,
       rolls forward to net10. See openspec/specs/lsp-server-swap/spec.md. -->
  <ItemGroup>
    <PackageVersion Include="EmmyLua.LanguageServer.Framework" Version="0.9.2" />
  </ItemGroup>
  <!-- MVVM / DI -->
  <ItemGroup>
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="PropertyChanged.SourceGenerator" Version="1.1.2" />
    <PackageVersion Include="Pure.DI" Version="2.4.2" />
    <PackageVersion Include="R3" Version="1.3.1" />
  </ItemGroup>
  <!-- Testing -->
  <ItemGroup>
    <PackageVersion Include="AwesomeAssertions" Version="9.4.0" />
    <!-- Roslyn 5 supports C# 14, the default for the net10 test sources it parses. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="xunit.analyzers" Version="2.0.0-pre.40" />
    <!-- CEILING, not a stale pin. xunit.v3 4.0.0 (still "Core Framework v3" — the package version and the
         framework generation are decoupled) breaks Avalonia.Headless.XUnit: MissingMethodException in
         AvaloniaFactDiscoverer.CreateTestCase, AvaloniaUI/Avalonia#22072, open and confirmed upstream.
         The package's own dependency is an open ">= 3.2.2", so NuGet resolves 4.0.0 happily and it fails
         only at test DISCOVERY — no build error, no restore warning. Raise this when #22072 closes. -->
    <PackageVersion Include="xunit.v3" Version="[3.2.2,4.0.0)" />
    <!-- At the Microsoft.Testing.Platform version xunit.v3 brings (1.9.1), which the extension must match. CI runs
         the Integration steps with hang dumps on, so a hung test is named and dumped inside the step limit (#2530). -->
    <PackageVersion Include="Microsoft.Testing.Extensions.HangDump" Version="1.9.1" />
  </ItemGroup>
  <!-- MCP server -->
  <ItemGroup>
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
  </ItemGroup>
  <!-- Other -->
  <ItemGroup>
    <PackageVersion Include="LanguageExt.Core" Version="5.0.0-beta-77" />
    <PackageVersion Include="Svg.Skia" Version="2.0.0" />
  </ItemGroup>
</Project>