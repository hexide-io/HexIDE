<Project Sdk="Microsoft.NET.Sdk">

  <!-- SPDX-License-Identifier: MIT -->
  <PropertyGroup>
    <TargetFrameworks>$(DotNetVersion)</TargetFrameworks>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <!-- Without this a failing run prints a COUNT and a path to a .log nobody has: CI cannot
         say which test failed, which cost a hunt the first time it happened. With it, the name,
         the assertion message, the file and line, and the stack all reach the console. -->
    <TestingPlatformShowTestsFailure>true</TestingPlatformShowTestsFailure>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" />
    <!-- Drive the server with the same transport the real IDE client uses (faithful framing check). -->
    <PackageReference Include="StreamJsonRpc" />
    <!-- Force the security-pinned MessagePack / Nerdbank.MessagePack over StreamJsonRpc's vulnerable
         transitive versions (mirrors IDE/HexIDE.Lsp; see the CVE pins in Directory.Packages.props). -->
    <PackageReference Include="MessagePack" />
    <PackageReference Include="Nerdbank.MessagePack" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.analyzers" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="AwesomeAssertions" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HexIDE.VbLspServer\HexIDE.VbLspServer.csproj" />
  </ItemGroup>

</Project>
