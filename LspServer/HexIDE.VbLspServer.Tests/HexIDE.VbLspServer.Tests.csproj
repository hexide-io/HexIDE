<Project Sdk="Microsoft.NET.Sdk">

  <!-- SPDX-License-Identifier: MIT -->
  <PropertyGroup>
    <TargetFrameworks>$(DotNetVersion)</TargetFrameworks>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" />
    <!-- Drive the server with the same transport the real IDE client uses (faithful framing check). -->
    <PackageReference Include="StreamJsonRpc" />
    <!-- Force the security-pinned MessagePack / Nerdbank.MessagePack over StreamJsonRpc's vulnerable
         transitive versions (mirrors IDE/HexIDE.Lsp; see the CVE pins in Directory.Packages.props). -->
    <PackageReference Include="MessagePack" />
    <PackageReference Include="Nerdbank.MessagePack" />
    <PackageReference Include="xunit.v3.mtp-v2" />
        <PackageReference Include="Microsoft.Testing.Extensions.Telemetry" />
        <PackageReference Include="Microsoft.Testing.Extensions.TrxReport.Abstractions" />
        <PackageReference Include="Microsoft.Testing.Platform" />
        <PackageReference Include="Microsoft.Testing.Platform.MSBuild" />
    <PackageReference Include="xunit.analyzers" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="AwesomeAssertions" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HexIDE.VbLspServer\HexIDE.VbLspServer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- One cleanup per test class: xunit v3 never calls Dispose beside DisposeAsync (#3411 slice 10b-3). -->
    <Compile Include="..\..\IDE\HexIDE.Tests\Infrastructure\TestClassCleanupTests.cs" Link="Infrastructure\TestClassCleanupTests.cs" />
  </ItemGroup>
</Project>
