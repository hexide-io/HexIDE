<Project Sdk="Microsoft.NET.Sdk">

  <!-- SPDX-License-Identifier: MIT -->
  <!-- The MIT VB6 language server (EmmyLua shell + proleap/grammars-v4 grammar). The sole VB6 LSP
       server; the whole tree is 100% MIT. See openspec/specs/lsp-server-swap/spec.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(DotNetVersion)</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Project name is HexIDE.VbLspServer, so the assembly/exe is HexIDE.VbLspServer.exe — exactly
         LspServerLocator's hardcoded probe. Keep this name (don't rename the csproj); no AssemblyName /
         RootNamespace override is needed now that the .Mit suffix is gone. -->

    <!-- Match the framework's AOT-first JSON posture: no reflection-based serialization. Custom-method
         payloads are registered via AddJsonSerializeContext (see VbLspProtocol.cs). PublishAot itself
         is deferred to Phase 6 (the Serilog file-logging contract vs. AOT trimming is settled there). -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <!-- CS0108: ANTLR-generated parser hides an inherited member (EMPTY() etc.) — expected artifact. -->
    <NoWarn>$(NoWarn);CS0108</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="EmmyLua.LanguageServer.Framework" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Antlr4.Runtime.Standard" />
    <PackageReference Include="Antlr4BuildTasks" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>

  <!-- proleap / grammars-v4 VB6 grammar (MIT), carrying HexIDE's clean-room fixes. Antlr4BuildTasks
       generates into the GLOBAL namespace (CustomToolNamespace is ignored) and does not escape C#
       keywords — check obj/ for exact generated method names. Parser Visitor=True for the scope
       analyzer + symbol provider. -->
  <ItemGroup>
    <Antlr4 Include="Grammar\VisualBasic6Lexer.g4">
      <Listener>False</Listener>
      <Visitor>False</Visitor>
    </Antlr4>
    <Antlr4 Include="Grammar\VisualBasic6Parser.g4">
      <Listener>False</Listener>
      <Visitor>True</Visitor>
    </Antlr4>
  </ItemGroup>


  <ItemGroup>
    <!-- The budget race in VbDiagnosticsProvider.RunWithin cannot be asserted through a real parse:
         ANTLR caches its DFA, so warm and cold runs differ by orders of magnitude. The test supplies
         work of a known duration instead. -->
    <InternalsVisibleTo Include="HexIDE.VbLspServer.Tests" />
  </ItemGroup>

</Project>
